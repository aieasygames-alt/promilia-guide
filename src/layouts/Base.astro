---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { t } from '../lib/i18n';
import { preview, type Locale } from '../lib/content';
import { origin, locales, languageTag } from '../lib/publication.mjs';
import { visuals, pageVisuals, imageObject } from '../lib/visuals';
interface Props {
  locale?: Locale; title: string; description: string; noindex?: boolean;
  alternates?: { lang: string; href: string }[];
  languageTarget?: string; missingTranslation?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[]; searchable?: boolean;
}
const { locale = 'zh-hans', title, description, noindex = false, alternates = [], languageTarget, missingTranslation = false, schema, searchable = true } = Astro.props;
const c = t(locale);
const root = `/${locale}/`;
const other = locale === 'zh-hans' ? 'ja' : 'zh-hans';
const canonical = origin + Astro.url.pathname;
const logoAlt = locale === 'en' ? 'Azur Promilia' : locale === 'ja' ? 'アズールプロミリア（Azur Promilia）' : '蓝色星原：旅谣（Azur Promilia）';
const logoUrl = origin + '/images/logo.png';
const nav = locale === 'en' ? [['', c.home], ['guides/download/', 'Download'], ['guides/getting-started/', 'Get started'], ['guides/resources/', 'Rewards'], ['characters/', 'Characters'], ['kibo/', 'Kibo'], ['faq/', c.faq]] : [['', c.home], ['guides/', c.guides], ['characters/', c.characters], ['kibo/', c.kibo], ['systems/', c.systems], ['database/', c.database], ['updates/', c.updates]];
const languageNames = { 'zh-hans': '简体中文', ja: '日本語', en: 'English' };
const languageOptions = locales.map((lang) => {
  const exact = alternates.find(alt => alt.lang === languageTag[lang]);
  return { locale: lang, name: languageNames[lang], href: exact ? new URL(exact.href).pathname : `/${lang}/`, fallback: !exact && Astro.url.pathname !== `/${lang}/` };
});
const active = (href: string) => href === '' ? Astro.url.pathname === root : Astro.url.pathname.startsWith(root + href);
const indexable = !noindex && !preview;
const isHome = Astro.url.pathname === root || Astro.url.pathname === '/';
const visualIds = pageVisuals(Astro.url.pathname);
const primary = visualIds[0];
const primaryImage = primary ? imageObject(primary, locale) : undefined;
const socialImage = primary ? { src: visuals[primary].src, width: visuals[primary].width, height: visuals[primary].height, alt: visuals[primary].alt[locale] } : { src: '/images/social.png', width: 1200, height: 630, alt: 'Promilia Guide' };
const metadata = Array.isArray(schema) ? schema.map(item => item['@type'] === 'Article' && primaryImage ? { ...item, image: primaryImage } : item) : schema || {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': origin + '/#organization', name: 'Promilia Guide', url: origin, logo: logoUrl },
    ...(isHome ? [{ '@type': 'WebSite', '@id': origin + `/${locale}/#website`, name: 'Promilia Guide', url: origin + `/${locale}/`, inLanguage: languageTag[locale] }] : []),
    { '@type': 'WebPage', name: title, url: canonical, inLanguage: languageTag[locale], description, publisher: { '@id': origin + '/#organization' }, ...(primaryImage ? { primaryImageOfPage: primaryImage, image: visualIds.map(id => imageObject(id, locale)) } : {}) },
  ],
};
---
<!doctype html>
<html lang={languageTag[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#193e3c" />
    <title>{title} | Promilia Guide</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index,follow,max-image-preview:large' : 'noindex,follow'} />
    <link rel="canonical" href={canonical} />
    {indexable && alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="Promilia Guide" />
    <meta property="og:type" content={Array.isArray(schema) ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : locale === 'ja' ? 'ja_JP' : 'zh_CN'} />
    <meta property="og:image" content={origin + socialImage.src} />
    <meta property="og:image:type" content={socialImage.src.endsWith('.webp') ? 'image/webp' : 'image/png'} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={origin + socialImage.src} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(metadata).replace(/</g, '\\u003c')} />
  </head>
  <body data-pagefind-ignore={searchable ? undefined : 'all'}>
    <a class="skip-link" href="#main">{c.skip}</a>
    {preview && <div class="preview-bar" data-pagefind-ignore><span>{c.preview}</span> {c.previewNote} <a href="/editorial/" style="text-decoration:underline;margin-left:12px">{locale === 'en' ? 'Editorial workspace' : locale === 'ja' ? '編集状況' : '编辑工作台'} ↗</a></div>}
    <header class="site-header" data-pagefind-ignore>
      <div class="header-inner">
        <a class="brand" href={root} aria-label={`Promilia Guide — ${c.home}`}>
          <span class="brand-identity"><img class="brand-logo" src="/images/logo-wordmark.webp" alt={logoAlt} width="444" height="183" /><small>{c.tagline}</small></span>
        </a>
        <nav class="desktop-nav" aria-label={c.menu}>
          {nav.map(([href, label]) => <a href={root + href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="search-shortcut" href={root + 'search/'} aria-label={c.searchLabel}><Icon name="search" size={19}/><span>{c.searchButton}</span><kbd>/</kbd></a>
          {locale !== 'en' && <div class="language-wrap">
            <a class="language-button" href={languageTarget || `/${other}/`} lang={languageTag[other]} aria-label={missingTranslation ? c.noTranslation + ' · ' + c.targetHome : c.language} data-language-choice={other}><Icon name="globe" size={17}/>{locale === 'zh-hans' ? '日本語' : '简中'}<span aria-hidden="true">↗</span></a>
            {missingTranslation && <span class="language-note">{c.noTranslation} · {c.targetHome}</span>}
          </div>}
          <details class="language-selector">
            <summary aria-label={c.language}><Icon name="globe" size={17}/>{locale === 'en' && <span>EN</span>}<span aria-hidden="true">⌄</span></summary>
            <nav aria-label={c.language}>{languageOptions.map(option => <a href={option.href} lang={languageTag[option.locale]} data-language-choice={option.locale} aria-current={option.locale === locale ? 'page' : undefined}>{option.name}{option.fallback && <small>{locale === 'en' ? 'Home' : locale === 'ja' ? 'ホーム' : '首页'}</small>}</a>)}</nav>
          </details>
          <details class="mobile-menu"><summary aria-label={c.menu}><span></span><span></span><span></span></summary><nav aria-label={c.menu}>{nav.map(([href, label]) => <a href={root + href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}</nav></details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="footer-inner"><div><a class="footer-brand" href={root} aria-label={`Promilia Guide — ${c.home}`}><img class="footer-logo" src="/images/logo-wordmark.webp" alt="" width="444" height="183" /></a><p>{c.footer}</p><small>{c.unofficial}</small></div><nav aria-label={locale === 'en' ? 'Site information' : locale === 'ja' ? 'サイト情報' : '站点信息'}>{locale === 'en' ? <><a href="/en/#guides">{c.guides}</a><a href="/en/faq/">{c.faq}</a><a href="/en/characters/">Characters</a><a href="/en/kibo/">Kibo</a><a href="/en/guides/support/">Game support</a><a href="/en/#about">{c.about}</a><a href="/en/#editorial-policy">{c.policy}</a><a href="/en/#corrections">{c.contact}</a></> : <><a href={root + 'faq/'}>{c.faq}</a><a href={root + 'database/'}>{c.database}</a><a href={root + 'about/'}>{c.about}</a><a href={root + 'editorial-policy/'}>{c.policy}</a><a href={root + 'contact/'}>{c.contact}</a></>}<a href="/">简中 / 日本語 / English</a></nav></div>
      <div class="footer-bottom"><span>© 2026 Promilia Guide</span><span>MADE FOR THE JOURNEY <span aria-hidden="true">✧</span></span></div>
    </footer>
    <script>
      document.addEventListener('keydown', (event) => {
        const el = event.target as HTMLElement;
        if (event.key === '/' && !event.metaKey && !event.ctrlKey && !el.matches('input, textarea, select, [contenteditable="true"]')) {
          event.preventDefault();
          const search = document.querySelector<HTMLInputElement>('#search-input');
          if (search) search.focus();
          else (document.querySelector('.search-shortcut') as HTMLAnchorElement)?.click();
        }
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-language-choice]').forEach((link) => link.addEventListener('click', () => {
        try { localStorage.setItem('promilia:language', link.dataset.languageChoice!); } catch { /* Language navigation remains available. */ }
      }));
    </script>
  </body>
</html>
