---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { type Entity } from '../../../data/entities';
import { referenceLocales as locales, origin, languageTag } from '../../../lib/publication.mjs';
import { t } from '../../../lib/i18n';
import { sources } from '../../../lib/facts';
import { preview, visibleEntitiesFor } from '../../../lib/content';
import { isEntityDetailPublishable } from '../../../lib/entity-publication.mjs';
import { entityImageSrcSet, entityDetailSizes } from '../../../lib/entity-images';

export function getStaticPaths() {
  return ['zh-hans', 'ja'].flatMap((locale) =>
    visibleEntitiesFor('character', locale as 'zh-hans' | 'ja').map((entity) => ({
      params: { locale, id: entity.id },
      props: { entity },
    }))
  );
}

interface Props {
  entity: Entity;
}

const { entity } = Astro.props;
const locale = Astro.params.locale as 'zh-hans' | 'ja';
const c = t(locale);
const ja = locale === 'ja';
const detailPublished = isEntityDetailPublishable(entity, locale, sources);
const showDetail = detailPublished || (preview && Boolean(entity.detailContent?.[locale]?.trim()));
const other = ja ? 'zh-hans' : 'ja';
const source = sources.find((s) => s.id === entity.sourceRefs[locale]);

const title = ja
  ? `${entity.names.ja}（${entity.romanized}）- キャラ紹介・公式プロフィール`
  : `${entity.names['zh-hans']}（${entity.romanized}）- 角色介绍与官方资料`;

const description = ja
  ? `『アズールプロミリア』の${entity.catalogStatus === 'verified' ? '公式キャラクター' : '確認中のキャラクター'}「${entity.names.ja}」。${entity.origin ? `所属・ゆかりの地：${entity.origin.ja}。` : ''}${entity.summary.ja}`
  : `《蓝色星原：旅谣》${entity.catalogStatus === 'verified' ? '官方公布角色' : '待核验角色'}「${entity.names['zh-hans']}」。${entity.origin ? `所属与相关地区：${entity.origin['zh-hans']}。` : ''}${entity.summary['zh-hans']}`;

const alternates = locales
  .map((l) => ({ lang: languageTag[l], href: `${origin}/${l}/characters/${entity.id}/` }))
  .concat([{ lang: 'x-default', href: `${origin}/zh-hans/characters/${entity.id}/` }]);

const canonical = `${origin}/${locale}/characters/${entity.id}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: entity.names[locale],
    alternateName: [entity.romanized, entity.names[other]],
    description: entity.summary[locale],
    image: `${origin}${entity.image}`,
    affiliation: {
      '@type': 'Organization',
      name: entity.origin?.[locale] || 'Azur Promilia',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: c.home, item: `${origin}/${locale}/` },
      { '@type': 'ListItem', position: 2, name: c.characters, item: `${origin}/${locale}/characters/` },
      { '@type': 'ListItem', position: 3, name: entity.names[locale], item: canonical },
    ],
  },
];

const allCharacters = visibleEntitiesFor('character', locale).filter((e) => e.id !== entity.id);
---

<Base
  locale={locale}
  title={title}
  description={description}
  alternates={alternates}
  languageTarget={`/${other}/characters/${entity.id}/`}
  schema={schema}
  noindex={!detailPublished}
  searchable={detailPublished}
>
  <div class="container">
    <nav class="breadcrumb" aria-label={ja ? 'パンくずリスト' : '面包屑'}>
      <a href={`/${locale}/`}>{c.home}</a>
      <span>/</span>
      <a href={`/${locale}/characters/`}>{c.characters}</a>
      <span>/</span>
      {entity.names[locale]}
    </nav>

    <header class="page-heading">
      <div class="card-tags">
        <span class="pill">{entity.catalogStatus === 'verified' ? (ja ? '公式発表' : '官方已公布') : (ja ? '確認中' : '待核验')}</span>
        <span class="pill">{entity.origin ? entity.origin[locale] : (ja ? '星原大陸' : '星原大陆')}</span>
      </div>
      <h1 data-pagefind-meta="title">{entity.names[locale]}</h1>
      <p class="entity-romanized" data-pagefind-meta="description">{entity.romanized}</p>
    </header>

    {!detailPublished && <p class="notice" data-entity-review-note>{ja ? '公式の人物・生態紹介をまとめたページです。スキルや育成の詳細ガイドは含みません。' : '本页提供官方名称与介绍，暂不含完整技能、培养和实战攻略。'}</p>}
    <article class="article-grid" data-pagefind-body={detailPublished || undefined}>
      <div>
        <div class="entity-card entity-card-character" style="margin-bottom: 2rem;">
          <figure class="entity-media entity-media-character" data-image-source={entity.imageSource}>
            <img
              class="entity-image"
              src={entity.image}
              srcset={entityImageSrcSet(entity.image)}
              sizes={entityDetailSizes}
              alt={entity.imageAlt[locale]}
              width="1200"
              height="1200"
              fetchpriority="high"
              decoding="async"
            />
            <figcaption>{entity.imageSource === 'official' ? (ja ? '公式画像' : '官方图片') : (ja ? '第三者画像' : '第三方图片')}</figcaption>
          </figure>

          <div class="entity-card-topline">
            <span class="pill">{ja ? 'キャラクター資料' : '角色档案'}</span>
          </div>

          <div class="prose" style="padding: 1.5rem 0;">
            {entity.quote && <blockquote>{entity.quote[locale]}</blockquote>}
            <p>{entity.summary[locale]}</p>
            {showDetail && <section data-entity-detail data-detail-status={detailPublished ? 'published' : 'draft'}><h2>{ja ? '人物紹介とゲーム内情報' : '人物介绍与游戏信息'}</h2>{entity.detailContent![locale]!.split(/\n{2,}/).map((paragraph) => <p>{paragraph}</p>)}</section>}
          </div>

          <dl class="entity-facts">
            {entity.cv && <div><dt>{ja ? '声優（CV）' : '声优（CV）'}</dt><dd><b>{entity.cv[locale]}</b></dd></div>}
            {entity.origin && <div><dt>{ja ? '所属・ゆかりの地' : '所属与相关地区'}</dt><dd>{entity.origin[locale]}</dd></div>}
            <div><dt>{ja ? '英語表記' : '英文标识'}</dt><dd>{entity.romanized}</dd></div>
            <div><dt>{ja ? '検索表記' : '别名索引'}</dt><dd>{entity.aliases[locale]}</dd></div>
          </dl>

          <footer class="entity-card-footer">
            <span>{ja ? '出典確認日：' : '来源核对：'}{source?.checkedAt || (ja ? '確認中' : '待核验')}</span>
            {source?.url && <a href={source.url} target="_blank" rel="noopener noreferrer">{ja ? '公式サイトの紹介へ' : '官方页面'}<Icon name="arrow" size={14}/></a>}
          </footer>
        </div>

        <section class="article-bottom">
          <h2>{ja ? '関連する攻略情報' : '相关推荐指南'}</h2>
          <div class="related-list">
            <a href={`/${locale}/guides/launch/`}>{ja ? '配信日と対象地域' : '公测日期与地区'}<Icon name="arrow" size={18}/></a>
            <a href={`/${locale}/guides/download/`}>{ja ? '公式の配布先と端末' : '官方入口与设备速查'}<Icon name="arrow" size={18}/></a>
            <a href={`/${locale}/guides/getting-started/`}>{ja ? 'サービス開始準備チェックリスト' : '开服准备与新手行动清单'}<Icon name="arrow" size={18}/></a>
            <a href={`/${locale}/guides/reroll/`}>{ja ? 'リセマラの判断材料と注意点' : '刷初始的判断依据与注意事项'}<Icon name="arrow" size={18}/></a>
          </div>
        </section>

        <section class="article-bottom">
          <h2>{ja ? '他の公開キャラクター' : '其他已公布角色'}</h2>
          <div class="related-list">
            {allCharacters.map((char) => (
              <a href={`/${locale}/characters/${char.id}/`}>
                {char.names[locale]}（{char.romanized}）
                <Icon name="arrow" size={18}/>
              </a>
            ))}
          </div>
        </section>
      </div>

      <aside class="article-aside">
        <div class="notice">
          <strong>{ja ? '公式根拠について' : '资料说明'}</strong>
          <p>{ja ? '公式人物紹介の名前と概要を掲載しています。スキルや育成素材は、プレイ中のゲーム内説明をご確認ください。' : '本页的名称与简介来自官方人物介绍。实际技能和培养材料请查看所玩版本的游戏内说明。'}</p>
        </div>
        <div style="margin-top: 1rem;">
          <a class="text-link" href={`/${locale}/characters/`}>← {ja ? 'キャラクター一覧へ戻る' : '返回角色图鉴总览'}</a>
        </div>
      </aside>
    </article>
  </div>
</Base>
