---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { type Entity } from '../../../data/entities';
import { referenceLocales as locales, origin, languageTag } from '../../../lib/publication.mjs';
import { t } from '../../../lib/i18n';
import { sources } from '../../../lib/facts';
import { preview, visibleEntitiesFor } from '../../../lib/content';
import { isEntityDetailPublishable } from '../../../lib/entity-publication.mjs';

export function getStaticPaths() {
  return ['zh-hans', 'ja'].flatMap((locale) =>
    visibleEntitiesFor('kibo', locale as 'zh-hans' | 'ja').map((entity) => ({
      params: { locale, id: entity.id },
      props: { entity },
    }))
  );
}

interface Props {
  entity: Entity;
}

const { entity } = Astro.props;
const locale = Astro.params.locale as 'zh-hans' | 'ja';
const c = t(locale);
const ja = locale === 'ja';
const detailPublished = isEntityDetailPublishable(entity, locale, sources);
const showDetail = detailPublished || (preview && Boolean(entity.detailContent?.[locale]?.trim()));
const other = ja ? 'zh-hans' : 'ja';
const source = sources.find((s) => s.id === entity.sourceRefs[locale]);

const title = ja
  ? `${entity.names.ja}（${entity.romanized}）- キボ図鑑・公式紹介と生態`
  : `${entity.names['zh-hans']}（${entity.romanized}）- 奇波图鉴 · 官方介绍与生态`;

const description = ja
  ? `『アズールプロミリア』の星霊「${entity.names.ja}」（${entity.romanized}）。${entity.classification ? `分類：${entity.classification.ja}。` : ''}${entity.summary.ja}`
  : `《蓝色星原：旅谣》官方星宠奇波「${entity.names['zh-hans']}」（${entity.romanized}）。${entity.classification ? `分类：${entity.classification['zh-hans']}。` : ''}${entity.summary['zh-hans']}`;

const alternates = locales
  .map((l) => ({ lang: languageTag[l], href: `${origin}/${l}/kibo/${entity.id}/` }))
  .concat([{ lang: 'x-default', href: `${origin}/zh-hans/kibo/${entity.id}/` }]);

const canonical = `${origin}/${locale}/kibo/${entity.id}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Thing',
    name: entity.names[locale],
    alternateName: [entity.romanized, entity.names[other]],
    description: entity.summary[locale],
    image: `${origin}${entity.image}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: c.home, item: `${origin}/${locale}/` },
      { '@type': 'ListItem', position: 2, name: c.kibo, item: `${origin}/${locale}/kibo/` },
      { '@type': 'ListItem', position: 3, name: entity.names[locale], item: canonical },
    ],
  },
];

const allKibo = visibleEntitiesFor('kibo', locale).filter((e) => e.id !== entity.id);
---

<Base
  locale={locale}
  title={title}
  description={description}
  alternates={alternates}
  languageTarget={`/${other}/kibo/${entity.id}/`}
  schema={schema}
  noindex={!detailPublished}
  searchable={detailPublished}
>
  <div class="container">
    <nav class="breadcrumb" aria-label={ja ? 'パンくずリスト' : '面包屑'}>
      <a href={`/${locale}/`}>{c.home}</a>
      <span>/</span>
      <a href={`/${locale}/kibo/`}>{c.kibo}</a>
      <span>/</span>
      {entity.names[locale]}
    </nav>

    <header class="page-heading">
      <div class="card-tags">
        <span class="pill">{entity.catalogStatus === 'verified' ? (ja ? '公式発表' : '官方已公布') : (ja ? '確認中' : '待核验')}</span>
        {entity.classification && <span class="pill">{entity.classification[locale]}</span>}
      </div>
      <h1 data-pagefind-meta="title">{entity.names[locale]}</h1>
      <p class="entity-romanized" data-pagefind-meta="description">{entity.romanized}</p>
    </header>

    {!detailPublished && <p class="notice" data-entity-review-note>{ja ? '公式の人物・生態紹介をまとめたページです。スキルや育成の詳細ガイドは含みません。' : '本页提供官方名称与介绍，暂不含完整技能、培养和实战攻略。'}</p>}
    <article class="article-grid" data-pagefind-body={detailPublished || undefined}>
      <div>
        <div class="entity-card entity-card-kibo" style="margin-bottom: 2rem;">
          <figure class="entity-media entity-media-kibo" data-image-source={entity.imageSource}>
            <img
              class="entity-image"
              src={entity.image}
              alt={entity.imageAlt[locale]}
              width="1200"
              height="1200"
              fetchpriority="high"
            />
            <figcaption>{entity.imageSource === 'official' ? (ja ? '公式画像' : '官方图片') : (ja ? '第三者画像' : '第三方图片')}</figcaption>
          </figure>

          <div class="entity-card-topline">
            <span class="pill">{ja ? 'キボ生態ファイル' : '奇波生态档案'}</span>
          </div>

          <div class="prose" style="padding: 1.5rem 0;">
            <p>{entity.summary[locale]}</p>
            {showDetail && <section data-entity-detail data-detail-status={detailPublished ? 'published' : 'draft'}><h2>{ja ? '生態とゲーム内の用途' : '生态与游戏内用途'}</h2>{entity.detailContent![locale]!.split(/\n{2,}/).map((paragraph) => <p>{paragraph}</p>)}</section>}
          </div>

          <dl class="entity-facts">
            {entity.classification && <div><dt>{ja ? '分類' : '分类'}</dt><dd><b>{entity.classification[locale]}</b></dd></div>}
            {entity.feature && <div><dt>{ja ? '特徴・機能' : '特性与机能'}</dt><dd>{entity.feature[locale]}</dd></div>}
            <div><dt>{ja ? '英語表記' : '英文标识'}</dt><dd>{entity.romanized}</dd></div>
            <div><dt>{ja ? '検索表記' : '别名索引'}</dt><dd>{entity.aliases[locale]}</dd></div>
          </dl>

          <footer class="entity-card-footer">
            <span>{ja ? '出典確認日：' : '来源核对：'}{source?.checkedAt || (ja ? '確認中' : '待核验')}</span>
            {source?.url && <a href={source.url} target="_blank" rel="noopener noreferrer">{ja ? '公式サイトの紹介へ' : '官方页面'}<Icon name="arrow" size={14}/></a>}
          </footer>
        </div>

        <section class="article-bottom">
          <h2>{ja ? '関連する攻略情報' : '相关推荐指南'}</h2>
          <div class="related-list">
            <a href={`/${locale}/guides/launch/`}>{ja ? '配信日と対象地域' : '公测日期与地区'}<Icon name="arrow" size={18}/></a>
            <a href={`/${locale}/guides/download/`}>{ja ? '公式の配布先と端末' : '官方入口与设备速查'}<Icon name="arrow" size={18}/></a>
            <a href={`/${locale}/guides/getting-started/`}>{ja ? 'サービス開始準備チェックリスト' : '开服准备与新手行动清单'}<Icon name="arrow" size={18}/></a>
            <a href={`/${locale}/systems/kibo/`}>{ja ? 'キボとの出会いと役割の調べ方' : '奇波获取与用途核对指南'}<Icon name="arrow" size={18}/></a>
            <a href={`/${locale}/systems/home/`}>{ja ? '農園とキボの協力作業' : '家园与奇波协作'}<Icon name="arrow" size={18}/></a>
          </div>
        </section>

        <section class="article-bottom">
          <h2>{ja ? '他の公開キボ' : '其他已公布奇波'}</h2>
          <div class="related-list">
            {allKibo.map((k) => (
              <a href={`/${locale}/kibo/${k.id}/`}>
                {k.names[locale]}（{k.romanized}）
                <Icon name="arrow" size={18}/>
              </a>
            ))}
          </div>
        </section>
      </div>

      <aside class="article-aside">
        <div class="notice">
          <strong>{ja ? 'キボの収集と生態について' : '奇波的生态与获取'}</strong>
          <p>{ja ? '公式の生態紹介を掲載しています。捕獲場所や解放条件はゲーム内の図鑑・任務表示を、戦闘や農園での用途は個体の能力をご確認ください。' : '本页提供官方生态介绍。捕获地点与解锁条件可在游戏内图鉴和任务提示中查看；战斗和家园岗位请读个体能力说明。'}</p>
        </div>
        <div style="margin-top: 1rem;">
          <a class="text-link" href={`/${locale}/kibo/`}>← {ja ? 'キボ一覧へ戻る' : '返回奇波图鉴总览'}</a>
        </div>
      </aside>
    </article>
  </div>
</Base>
