---
import BannerCharacters from '../../components/BannerCharacters.astro';
import LaunchRoster from '../../components/LaunchRoster.astro';
import Base from '../../layouts/Base.astro';
import ContentRoutes from '../../components/ContentRoutes.astro';
import { visibleEntitiesFor, visibleGuides, type ReferenceLocale as Locale } from '../../lib/content';
import { sources } from '../../lib/facts';
import { isEntityCatalogPublishable } from '../../lib/entity-publication.mjs';
import { worldRegions } from '../../data/world-regions';
import { referenceLocales as locales, languageTag, origin } from '../../lib/publication.mjs';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const ja = locale === 'ja';
const characters = visibleEntitiesFor('character', locale).filter(entity => isEntityCatalogPublishable(entity, locale, sources));
const kibo = visibleEntitiesFor('kibo', locale).filter(entity => isEntityCatalogPublishable(entity, locale, sources));
const entries = await visibleGuides(locale);
const title = ja ? 'アズールプロミリア図鑑：キャラ・キボ・地域・システム' : '蓝色星原图鉴：角色、奇波、地区与系统索引';
const description = ja ? '公式に確認したキャラクターとキボの名前・分類・紹介をまとめ、地域設定と攻略への入口を掲載。技能や素材の未確認項目も区別します。' : '汇总蓝色星原已核验角色与奇波名称、分类及官方简介，补充日本官网地区设定，连接新手、家园、战斗和常见问题指南。';
const worldSource = sources.find(source => source.id === 'jp-world-overview-2026-11-24');
const worldAvailable = worldSource?.status === 'verified';
const alternates = locales.map(l => ({ lang: languageTag[l], href: `${origin}/${l}/database/` })).concat([{ lang: 'x-default', href: `${origin}/zh-hans/database/` }]);
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: `${origin}/${locale}/database/`, inLanguage: languageTag[locale], hasPart: ['characters', 'kibo', 'systems', 'faq'].map(path => ({ '@type': 'WebPage', url: `${origin}/${locale}/${path}/` })) };
---
<Base locale={locale} title={title} description={description} alternates={alternates} languageTarget={`/${ja ? 'zh-hans' : 'ja'}/database/`} schema={schema}>
  <div class="container">
    <nav class="breadcrumb" aria-label={ja ? 'パンくずリスト' : '面包屑'}><a href={`/${locale}/`}>{ja ? 'ホーム' : '首页'}</a><span>/</span>{ja ? '図鑑' : '图鉴'}</nav>
    <header class="page-heading"><p class="eyebrow">A FIELD GUIDE TO PROMILIA</p><h1>{title}</h1><p>{description}</p></header>
    <div data-pagefind-body>
      <nav class="database-index" aria-label={ja ? '図鑑の分類' : '图鉴分类'}>
        <a href="#characters"><strong>{String(characters.length).padStart(2, '0')}</strong><span>{ja ? 'キャラクター' : '角色资料'}<small>{ja ? '名前・設定・出典' : '姓名、设定与来源'}</small></span></a>
        <a href="#kibo"><strong>{String(kibo.length).padStart(2, '0')}</strong><span>{ja ? 'キボ' : '奇波资料'}<small>{ja ? '分類・生態・出典' : '分类、生态与来源'}</small></span></a>
        {worldAvailable && <a href="#regions"><strong>{String(worldRegions.length).padStart(2, '0')}</strong><span>{ja ? '地域設定' : '地区设定'}<small>{ja ? '日本公式の紹介' : '日本官网原文名称'}</small></span></a>}
        <a href={`/${locale}/faq/#database`}><strong>?</strong><span>{ja ? '資料の読み方' : '资料怎么看'}<small>{ja ? '技能・育成・入手の確認範囲' : '技能、养成与获取的核验范围'}</small></span></a>
      </nav>
      <p class="notice">{ja ? '掲載件数は当サイトが照合した紹介数で、ゲーム内の全キャラクター・全キボ数ではありません。名前と設定の資料から、技能・強さ・素材・捕獲場所を推定しません。' : '这里的数量是本站已核验介绍数，不代表游戏全部角色或奇波总数。名称与设定资料不能替代技能、强度、材料和捕获地点证据。'}</p>
      <BannerCharacters locale={locale}/>
      <LaunchRoster locale={locale}/>
      {[{ id: 'characters', items: characters, label: ja ? 'キャラクター早見表' : '角色名称速查', path: 'characters' }, { id: 'kibo', items: kibo, label: ja ? 'キボ早見表' : '奇波名称速查', path: 'kibo' }].map(group => <section class="database-section" aria-labelledby={group.id}>
        <div class="section-head"><h2 id={group.id}>{group.label}</h2><a class="text-link" href={`/${locale}/${group.path}/`}>{ja ? '画像付き一覧へ' : '查看图文目录'} →</a></div>
        <div class="database-table"><table><caption class="sr-only">{group.label}</caption><thead><tr><th scope="col">{ja ? '名前 / 英文表記' : '名称／英文标识'}</th><th scope="col">{ja ? '所属・分類' : '所属／分类'}</th><th scope="col">{ja ? '紹介・資料' : '介绍与资料'}</th></tr></thead><tbody>{group.items.map(entity => <tr><th scope="row"><a href={`/${locale}/${group.path}/${entity.id}/`}>{entity.names[locale]}</a><small>{entity.romanized}</small></th><td>{entity.origin?.[locale] || entity.classification?.[locale]}</td><td><p>{entity.summary[locale]}</p><a href={sources.find(source => source.id === entity.sourceRefs[locale])!.url!} target="_blank" rel="noopener noreferrer">{ja ? '公式出典' : '官方来源'} ↗</a></td></tr>)}</tbody></table></div>
      </section>)}
      {worldAvailable && <section class="database-section" aria-labelledby="regions"><div class="section-head"><h2 id="regions">{ja ? '世界・地域の公開設定' : '世界与地区的公开设定'}</h2><a class="text-link" href={worldSource!.url!} target="_blank" rel="noopener noreferrer">{ja ? '日本公式の地域紹介' : '日本官网地区介绍'} ↗</a></div><p class="database-note">{ja ? '以下は日本公式の世界設定で、攻略順・進入条件・採集座標の案内ではありません。' : '以下按日本官网世界观介绍整理，保留日本原名；不是国服正式译名对照、开荒顺序、进入条件或采集坐标。'}</p><dl class="world-regions">{worldRegions.map(region => <div><dt>{region.name}</dt><dd>{region.note[locale]}</dd></div>)}</dl><p class="database-note">{ja ? '出典確認日' : '来源核对'}：{worldSource!.checkedAt}</p></section>}
      <section class="database-section"><h2>{ja ? '素材・装備・任務を調べたいとき' : '要查材料、装备与任务时'}</h2><p class="database-note">{ja ? '個別のレシピ、育成費用、採集場所は未検証です。目的別ガイドで現在の確認範囲を読み、図鑑の設定と実際の条件を区別してください。' : '逐项配方、养成消耗和采集点尚未核实。先从用途指南核对现有条件，区分图鉴设定、活动来源与正式任务；有完整证据后再补具体条目。'}</p><ContentRoutes locale={locale} entries={entries} section="systems"/><a class="text-link" href={`/${locale}/faq/#database`}>{ja ? '図鑑・素材のよくある質問' : '图鉴与材料常见问题'} →</a></section>
    </div>
  </div>
</Base>
<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .database-index { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 2px solid var(--green); margin-bottom: 2rem; }
  .database-index a { display: flex; gap: 1rem; align-items: center; padding: 1.5rem 1rem; border-bottom: 1px solid var(--line); }
  .database-index strong { font: italic 2.1rem Georgia, serif; color: var(--green); }
  .database-index span { font-weight: 600; } small { display: block; color: var(--muted); font-size: .8rem; font-weight: 400; margin-top: .3rem; }
  .database-section { margin: 3.5rem 0; } h2[id] { scroll-margin-top: 105px; } h2 { font-size: 1.45rem; }
  .database-table { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); }
  table { border-collapse: collapse; width: 100%; text-align: left; line-height: 1.8; font-size: .9rem; }
  th, td { padding: 1rem 1.2rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  thead { background: #edf1e9; } tbody th { min-width: 140px; width: 20%; } td:nth-child(2) { width: 22%; }
  td p { margin: 0 0 .5rem; } td a, tbody th a { color: var(--green); text-decoration: underline; text-underline-offset: .2em; }
  .database-note { line-height: 1.9; color: var(--muted); margin-bottom: 1.5rem; }
  .world-regions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; }
  .world-regions div { border-top: 1px solid var(--line); padding: 1.2rem 0; } dt { font-weight: 600; margin-bottom: .5rem; } dd { margin: 0; line-height: 1.9; font-size: .95rem; }
  @media (max-width: 820px) { .database-index { grid-template-columns: repeat(2, minmax(0, 1fr)); } .world-regions { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .database-index a { padding: 1rem .3rem; gap: .6rem; } .database-index strong { font-size: 1.6rem; } th, td { padding: .8rem; } table { min-width: 580px; } }
</style>
