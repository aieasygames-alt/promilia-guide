---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Checklist from '../../../components/Checklist.astro';
import Icon from '../../../components/Icon.astro';
import ClaimSummary from '../../../components/ClaimSummary.astro';
import DistributionMatrix from '../../../components/DistributionMatrix.astro';
import ArticleToc from '../../../components/ArticleToc.astro';
import FeatureVisual from '../../../components/FeatureVisual.astro';
import RedeemCodeBox from '../../../components/RedeemCodeBox.astro';
import MobileActionBar from '../../../components/MobileActionBar.astro';
import { allGuides, visibleGuides, articlePath, isPublished, type Guide } from '../../../lib/content';
import { alternateLinks, origin } from '../../../lib/publication.mjs';
import { t } from '../../../lib/i18n';
import { sources, claims } from '../../../lib/facts';
import { effectiveSourceRefs, publicationIssues } from '../../../lib/editorial.mjs';
import terms from '../../../data/terms.json';
export async function getStaticPaths() {
  return (await visibleGuides()).map((entry) => ({ params: { locale: entry.data.locale, section: entry.data.section, slug: entry.data.slug }, props: { entry } }));
}
interface Props { entry: Guide }
const { entry } = Astro.props;
const { data } = entry;
const locale = data.locale;
const c = t(locale);
const { Content, headings } = await render(entry);
const all = await allGuides();
const published = isPublished(data, all);
const issues = publicationIssues(data, { entries: all, sources, claims });
const factsVerified = data.sourceRefs.some((id) => sources.find((source) => source.id === id)?.status === 'verified');
const visible = await visibleGuides();
const other = locale === 'zh-hans' ? 'ja' : 'zh-hans';
const translation = visible.find((e) => e.data.contentId === data.contentId && e.data.locale === other);
const related = data.related.flatMap((id) => { const entry = visible.find((e) => e.data.contentId === id && e.data.locale === locale); return entry ? [entry] : []; });
const references = effectiveSourceRefs(data, claims).map((id: string) => sources.find((s) => s.id === id)!);
const aliases = [...new Set([...data.aliases, ...terms.find((term) => term.id === 'game')!.aliases])];
const url = origin + articlePath(data);
const sectionLabel = data.section === 'systems' ? c.systems : c.guides;
const hasDistribution = ['download', 'platforms'].includes(data.contentId);
const isRedeemCodes = data.contentId === 'redeem-codes';
const compactFacts = ['requirements', 'reroll'].includes(data.contentId);
const featureVisual = data.contentId === 'launch' ? 'public-beta' : null;
const toc = [
  ...(hasDistribution ? [{ id: 'distribution-title', text: locale === 'ja' ? '地域・端末の早見表' : '地区与设备速查' }] : []),
  ...(data.claimRefs.length ? [{ id: compactFacts ? 'claim-summary-details' : 'claim-summary-title', text: locale === 'ja' ? '確認できたこと・確認中のこと' : '已确认与待确认' }] : []),
  ...headings.filter((heading) => heading.depth === 2).map((heading) => ({ id: heading.slug, text: heading.text })),
  { id: 'sources', text: c.sources }, { id: 'revisions', text: c.revisions },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: data.title, description: data.description, inLanguage: locale === 'ja' ? 'ja' : 'zh-Hans', datePublished: data.publishedAt, dateModified: data.updatedAt, author: { '@type': 'Organization', name: data.author }, mainEntityOfPage: url, image: origin + '/images/social.png' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: c.home, item: origin + `/${locale}/` }, { '@type': 'ListItem', position: 2, name: sectionLabel, item: origin + `/${locale}/${data.section}/` }, { '@type': 'ListItem', position: 3, name: data.title, item: url }] },
];
---
<Base locale={locale} title={data.title} description={data.description} noindex={!published} alternates={alternateLinks(all.filter((entry) => isPublished(entry.data, all)), data.contentId)} languageTarget={translation ? articlePath(translation.data) : `/${other}/`} missingTranslation={!translation} schema={schema}>
  <div class="container"><nav class="breadcrumb" aria-label={locale === 'ja' ? 'パンくずリスト' : '面包屑'}><a href={`/${locale}/`}>{c.home}</a><span>/</span><a href={`/${locale}/${data.section}/`}>{sectionLabel}</a><span>/</span>{data.title}</nav>
    <header class="page-heading"><div class="card-tags"><span class={`pill ${data.verification === 'pending' ? 'pending' : ''}`}>{c[data.verification]}</span>{!published && <span class="pill draft">{c.draft}</span>}</div><h1 data-pagefind-meta="title">{data.title}</h1><p data-pagefind-meta="description">{data.description}</p><div class="metadata"><span>{c.region}<b>{data.gameRegion}</b></span><span>{c.version}<b>{data.gameVersion}</b></span><span>{c.updated}<b><time datetime={data.updatedAt}>{data.updatedAt}</time></b></span><span>{c.author}<b>{data.author}</b></span></div></header>
    {!published && <div class="notice"><strong>{c.draft}</strong>{factsVerified ? (locale === 'ja' ? '公式資料を登録・照合しました。公開前の編集・日本語レビューはまだ完了していません。' : '已录入并核对官方资料，公开前的正文与语言审核仍待完成。') : c.sourcePending}<br/>{locale === 'ja' ? 'レビューが完了するまで、本番ビルドから除外します。' : '正式构建会排除本页；真实审核人与审核日期不会由程序自动填写。'}{issues.some((issue) => ['stale-claim', 'stale-translation'].includes(issue.code)) && <p>{locale === 'ja' ? '原稿または共有情報の改訂が進んでいます。本文を再確認してください。' : '原稿或共享事实已经更新，请重新核对正文。'}</p>}</div>}
    {!translation && <p class="search-help">{c.missing} · <a class="text-link" href={`/${other}/`}>{c.targetHome} ↗</a></p>}
    {featureVisual && <FeatureVisual id={featureVisual} locale={locale}/>}
    <div class="article-grid"><article data-pagefind-body data-content-id={data.contentId} data-published={String(published)}>
      {hasDistribution && <DistributionMatrix locale={locale}/>}
      {isRedeemCodes && <RedeemCodeBox locale={locale}/>}
      {compactFacts ? <details id="claim-summary-details" class="article-facts"><summary>{locale === 'ja' ? '出典と確認状況を開く' : '展开来源与核验状态'}</summary><ClaimSummary locale={locale} refs={data.claimRefs} revisions={data.claimRevisions}/></details> : <ClaimSummary locale={locale} refs={data.claimRefs} revisions={data.claimRevisions}/>}
      <div class="prose"><Content/></div>
      {data.checklist.length > 0 && <Checklist locale={locale} contentId={data.contentId} items={data.checklist}/>}
      <section class="article-bottom" id="sources"><h2>{c.sources}</h2><ul class="source-list">{references.map((source) => <li id={`source-${source.id}`}><strong>{source.url ? <a href={source.url} rel="noopener noreferrer" target="_blank">{source.localized?.[locale]?.title || source.title}</a> : source.localized?.[locale]?.title || source.title}</strong><small>{source.publisher} · {source.localized?.[locale]?.note || source.note}</small><small>{source.publishedAt && `${locale === 'ja' ? '掲載日' : '原文发布'}：${source.publishedAt} · `}{source.checkedAt ? `${locale === 'ja' ? '出典確認日' : '来源核对'}：${source.checkedAt}` : c.sourcePending}</small><span class={`pill ${source.status === 'verified' ? '' : 'pending'}`}>{source.status === 'verified' ? (locale === 'ja' ? '出典確認済み' : '来源已核验') : (locale === 'ja' ? '公式根拠として未確認' : '非已核验官方证据')}</span></li>)}</ul></section>
      <section class="article-bottom" id="revisions" data-pagefind-ignore data-nosnippet><h2>{c.revisions}</h2>{data.revisions.map((revision) => <div class="archive-row"><time datetime={revision.date}>{revision.date}</time><p>{revision.note}</p></div>)}</section>
      {related.length > 0 && <section class="article-bottom" data-pagefind-ignore><h2>{c.next}</h2><div class="related-list">{related.map((e) => <a href={articlePath(e.data)}>{e.data.title}<Icon name="arrow" size={18}/></a>)}</div></section>}
      <div class="metadata" data-pagefind-weight="0.2"><span>{locale === 'ja' ? '検索用の表記' : '搜索别名'}：{aliases.join(' · ')}</span></div>
      <a class="text-link" href={`/${locale}/contact/?page=${encodeURIComponent(articlePath(data))}`}>{c.contact}<Icon name="arrow" size={16}/></a>
    </article><ArticleToc locale={locale} items={toc}/></div>
    <MobileActionBar locale={locale}/>
  </div>
</Base>
<style>
  .article-facts { margin: 1rem 0 1.5rem; padding: .85rem 1rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .article-facts summary { cursor: pointer; font-weight: 600; }
  .article-facts[open] summary { margin-bottom: 1rem; }
</style>
