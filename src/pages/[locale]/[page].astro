---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import GuideCard from '../../components/GuideCard.astro';
import EntityCard from '../../components/EntityCard.astro';
import Search from '../../components/Search.astro';
import Feedback from '../../components/Feedback.astro';
import { visibleGuides, allGuides, entitiesFor, isPublished, type Locale } from '../../lib/content';
import { locales, origin, languageTag } from '../../lib/publication.mjs';
import { t } from '../../lib/i18n';
import { sources } from '../../lib/facts';
export function getStaticPaths() {
  return ['zh-hans', 'ja'].flatMap((locale) => ['guides', 'systems', 'characters', 'kibo', 'updates', 'about', 'editorial-policy', 'contact', 'search'].map((page) => ({ params: { locale, page } })));
}
const locale = Astro.params.locale as Locale;
const page = Astro.params.page!;
const c = t(locale);
const ja = locale === 'ja';
const announcements = sources.filter((source) => source.kind === 'official' && source.status === 'verified' && source.publishedAt && source.url);
const labels: Record<string, string> = { guides: c.guides, systems: c.systems, characters: c.characters, kibo: c.kibo, updates: c.updates, about: c.about, 'editorial-policy': c.policy, contact: c.contact, search: c.searchLabel };
const intros: Record<string, string> = ja ? {
  guides: '配信情報から旅の準備まで。必要なことを、行動の順番に沿って。', systems: '操作の条件と根拠を一つずつ確認し、ゲームの仕組みを理解しましょう。', characters: '公式サイトで紹介された4人のキャラクターを、名前・役割・ゆかりの地と一緒に確認できます。', kibo: '公式サイトで紹介された5種のキボを、名前・分類・公開された特徴から整理します。', updates: '情報の変更点、対象範囲と確認状況を記録します。', about: '未知の世界を歩くための、プレイヤーによる非公式の道しるべ。', 'editorial-policy': '情報の根拠と対象範囲を示し、確認できていないことを区別します。', contact: '誤りや古い情報を見つけたら、根拠と一緒に修正メモを作成できます。', search: c.searchHelp,
} : {
  guides: '从发行信息到开服准备，按行动顺序，找到此刻需要的答案。', systems: '讲清操作、前提与例外，再把机制用到你的旅途中。', characters: '整理官网已公布的 4 个角色：名称、官方简介、英文名与相关地区。', kibo: '整理官网已公布的 5 个奇波：名称、英文标识、分类与公开特征。', updates: '记录改了什么、依据是什么，以及适用于哪个地区与版本。', about: '一份玩家自建的星原旅行手册，陪你走好每一次出发。', 'editorial-policy': '让已知有依据，让未知保持清楚，让每次修订都有迹可循。', contact: '如果发现错误或过时内容，可以在这里整理问题与可核对的依据。', search: c.searchHelp,
};
const entries = (await visibleGuides(locale)).filter((entry) => page === 'systems' ? entry.data.section === 'systems' : entry.data.section === 'guides');
const catalog = page === 'guides' || page === 'systems';
const entityKind = page === 'characters' ? 'character' : page === 'kibo' ? 'kibo' : null;
const entityEntries = entityKind ? entitiesFor(entityKind) : [];
const all = await allGuides();
const noindex = ['search'].includes(page) || (catalog && entries.filter((e) => isPublished(e.data, all)).length < 2);
const alternates = locales.map((l) => ({ lang: languageTag[l], href: origin + `/${l}/${page}/` })).concat([{ lang: 'x-default', href: origin + `/zh-hans/${page}/` }]);
---
<Base locale={locale} title={labels[page]} description={intros[page]} noindex={noindex} searchable={!['search', 'contact'].includes(page) && (!catalog || entries.length > 0)} alternates={alternates} languageTarget={`/${ja ? 'zh-hans' : 'ja'}/${page}/`}>
  <div class="container"><nav class="breadcrumb" aria-label={ja ? 'パンくずリスト' : '面包屑'}><a href={`/${locale}/`}>{c.home}</a><span>/</span>{labels[page]}</nav><header class="page-heading"><p class="eyebrow">PROMILIA FIELD NOTES</p><h1>{labels[page]}</h1><p>{intros[page]}</p></header>
    {catalog && (entries.length ? <div class="catalog-list">{entries.map((entry, index) => <GuideCard entry={entry} index={index}/>)}</div> : <div class="empty-state"><Icon name="book" size={32}/><h2>{c.noContent}</h2><p>{c.noContentNote}</p><a class="text-link" href={`/${locale}/editorial-policy/`}>{c.policy}<Icon name="arrow" size={17}/></a></div>)}
    {page === 'search' && <><Search locale={locale}/><a class="text-link" href={`/${locale}/guides/`}>{c.browse}<Icon name="arrow" size={17}/></a></>}
    {entityKind && <section class="entity-catalog" data-entity-catalog={entityKind} data-pagefind-body>
      <div class="notice entity-notice">{ja ? '公式サイトで公開された名称と紹介文を、地域ごとの表記のまま掲載しています。技能倍率、育成素材、強さ、入手場所は公式根拠が確認できるまで追加しません。' : '以下内容来自官方站已公开的名称与介绍，并保留各地区原始表记。技能倍率、养成材料、强度和获取地点在有明确官方依据前不会补充。'}</div>
      <div class="entity-grid">{entityEntries.map((entity, index) => <EntityCard entity={entity} locale={locale} index={index} source={sources.find((source) => source.id === entity.sourceRefs[locale])}/>)}</div>
      <div class="prose entity-editorial-note"><h2>{ja ? '出典と範囲' : '来源与范围'}</h2><p>{ja ? '名称・分類・短い紹介は公式キャラクター／キボ一覧を照合しました。日本公式サイトに追加掲載されているメーツァは、今回の4人の範囲外として未収録です。' : '名称、分类和简短介绍已分别对照官方角色/奇波列表。日本官网另有追加角色メーツァ，本轮按 4 个角色的范围暂未收录。'}</p><a class="text-link" href={`/${locale}/updates/`}>{c.updates}<Icon name="arrow" size={17}/></a></div>
    </section>}
    {page === 'updates' && <div class="narrow"><div class="notice">{ja ? '公式ニュースは原文の掲載日、サイトの修訂は編集日で記録します。対象地域と確認範囲も明記します。' : '官方公告按原文发布日期记录，本站修订按编辑日期记录，并注明适用地区与核验范围。'}</div>{announcements.map((source) => <div class="archive-row"><time datetime={source.publishedAt!}>{source.publishedAt}</time><div><span class="pill">{ja ? '公式ニュース' : '官方公告'}</span><h2><a href={source.url!} target="_blank" rel="noopener noreferrer">{source.localized?.[locale]?.title || source.title} ↗</a></h2><p>{source.localized?.[locale]?.note || source.note}</p><small>{ja ? '出典確認日' : '来源核对'}：{source.checkedAt}</small></div></div>)}<div class="archive-row"><time datetime="2026-11-14">2026.11.14</time><div><span class="pill">{ja ? 'サイトの更新' : '本站修订'}</span><h2>{ja ? '初回記事の公開前確認を完了し、正式ドメインで公開' : '首批攻略完成审核，正式主域名上线'}</h2><p>{ja ? '配信日程、ダウンロード、動作環境、旅の準備、対応プラットフォームなど、6テーマの中国語・日本語記事、計12本の確認を完了しました。正式URLは promiliaguide.com です。今後の記事も出典・内容・言語の確認後に公開します。' : '发行日程、下载、配置、开服准备与平台等六个主题的中日文共 12 篇稿件已完成真实正文与语言审核，并在 promiliaguide.com 正式上线。后续新增内容仍按来源、正文与语言审核流程逐篇发布。'}</p></div></div><div class="prose"><h2>{ja ? '修正が必要な情報を見つけたら' : '发现需要修订的地方'}</h2><p>{ja ? '対象の記事、地域、バージョンと資料を添えて、修正メモを作成してください。' : '请附上相关页面、地区、版本与原始资料，整理为纠错记录。'}</p><a href={`/${locale}/contact/`}>{c.contact} →</a></div></div>}
    {page === 'about' && <div class="narrow prose" data-pagefind-body><h2>{ja ? 'このサイトが目指すこと' : '我们希望解决的问题'}</h2><p>{ja ? 'Promilia Guide は、配信情報、準備の手順、ゲームの仕組みを探しやすくまとめる非公式ガイドです。読む人が「次に何をするか」と「どの地域・バージョンの情報か」を判断できるように整理します。' : 'Promilia Guide（星原旅伴）是面向简体中文和日语读者的非官方攻略站。我们整理发行信息、准备步骤与机制说明，希望你读完能知道下一步做什么，以及信息适用于哪个地区和版本。'}</p><h2>{ja ? '情報との向き合い方' : '我们如何对待信息'}</h2><p>{ja ? '公式発表、テスト版の記録、編集上の提案、確認中の内容を区別します。AI による編集補助や翻訳の下書きは、確認が終わるまで公開しません。架空のプレイ経験やレビュー担当者を記載しません。' : '官方已公布、测试观察、编辑建议和待核验内容分别标记。AI 可协助整理与翻译初稿；来源与语言审核完成前保留草稿。不虚构游玩经验、作者资历或审核人员。'}</p><h2>{ja ? '運営と権利について' : '非官方与版权说明'}</h2><p>{c.unofficial} {ja ? 'ゲーム名、商標、画像等の権利は各権利者に帰属します。装飾用の風景は当サイトのオリジナル SVG で、ゲーム画面ではありません。' : '游戏名称、商标及游戏素材权利属于相应权利人。站内风景装饰为原创 SVG 插画，不代表游戏实机画面。'}</p><h2>{ja ? 'プライバシー' : '隐私与本地记录'}</h2><p>{ja ? 'アカウント登録は不要です。チェックリストと手動の言語選択をブラウザーに保存します。現在、アクセス解析や広告用のトラッカーは導入していません。検索は配信済みの静的インデックスで処理します。' : '本站无需注册。清单进度和手动语言选择保存在浏览器本地；目前未接入统计、广告追踪或第三方字体。搜索在已部署的静态索引中执行。'}</p><p><a href={`/${locale}/editorial-policy/`}>{c.policy}</a> · <a href={`/${locale}/contact/`}>{c.contact}</a></p></div>}
    {page === 'editorial-policy' && <div class="narrow prose" data-pagefind-body><h2>{ja ? '結論の種類を明記する' : '先说明结论的性质'}</h2><ul><li><strong>{c.official}</strong> — {ja ? '原文と対象範囲を確認した公式発表。' : '回溯原始公告并核对适用范围的事实。'}</li><li><strong>{c.test}</strong> — {ja ? 'バージョンと条件を記録したテストの観察。正式版とは区別します。' : '有版本与复核条件的测试记录，不自动套用到公测。'}</li><li><strong>{c.editorial}</strong> — {ja ? '前提と理由を説明した手順や提案。ゲーム内の保証ではありません。' : '说明前提与原因的行动建议，不冒充官方规则。'}</li><li><strong>{c.pending}</strong> — {ja ? '原文未確認や矛盾が残る項目。確定情報として扱いません。' : '来源未录入、存在冲突或证据不足的内容。'}</li></ul><h2>{ja ? '出典と日付' : '来源和日期分别记录'}</h2><p>{ja ? '発表者、URL、掲載日、照合日、対象バージョンを記録します。動画は必要な時刻も記載します。出典を再確認した日だけでは、記事の内容更新日を変更しません。企画書や競合調査は、ゲームの公式根拠にはなりません。' : '来源记录发布者、原始链接、发布日期、核对日期和适用版本；视频保留相关时间点。仅检查来源没有实质变动时，不刷新文章更新时间。项目规划和竞品研究不能替代游戏官方证据。'}</p><h2>{ja ? '言語とサーバーを区別する' : '语言与服务器独立'}</h2><p>{ja ? '日本語の記事が日本向けサーバーを説明するとは限りません。各ページに地域とバージョンを表示します。翻訳には原稿の改訂番号を記録し、重要な変更があれば再レビューします。未公開の翻訳へのリンクは生成しません。' : '日语文章可以讨论中国大陆服，但必须标明地区和版本。译文记录原稿修订号；重大事实变化后重新审核。未发布的译文不会生成替代语言链接。'}</p><h2>{ja ? '公開前の確認' : '发布前的必要审核'}</h2><ol><li>{ja ? '見出しの疑問に本文が答え、読者が使える手順になっているか。' : '标题承诺的问题有答案，步骤与适用条件完整。'}</li><li>{ja ? '判断に影響する事実に、原文と対象範囲があるか。' : '关键事实有原始证据，冲突和未知项可见。'}</li><li>{ja ? '用語と自然な表現を確認した担当者・日付が記録されているか。' : '名称与语言完成审核，并记录真实审核人与日期。'}</li><li>{ja ? 'リンク、検索、モバイル表示、索引設定が正しいか。' : '构建、内链、搜索、手机展示和索引设置通过检查。'}</li></ol><h2>{ja ? '訂正と素材の相談' : '纠错与素材反馈'}</h2><p>{ja ? '誤りは根拠を確認して修正し、理由と影響範囲を履歴に残します。素材の権利に関する相談では、該当 URL と権利を確認できる資料を添えてください。' : '错误经过核对后修订，记录变更原因与影响范围。素材权利反馈请附具体 URL 与可确认权利关系的资料。'}</p><a href={`/${locale}/contact/`}>{c.contact} →</a></div>}
    {page === 'contact' && <div class="narrow"><Feedback locale={locale}/><p class="search-help">{ja ? 'パスワード、認証コード、個人を特定できる情報は記入しないでください。' : '请勿填写密码、验证码或不必要的个人信息。'}</p><a class="text-link" href={`/${locale}/editorial-policy/`}>{c.policy}<Icon name="arrow" size={17}/></a></div>}
  </div>
</Base>
