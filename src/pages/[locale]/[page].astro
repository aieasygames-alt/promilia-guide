---
import BannerCharacters from '../../components/BannerCharacters.astro';
import Base from '../../layouts/Base.astro';
import LaunchRoster from '../../components/LaunchRoster.astro';
import LaunchKibo from '../../components/LaunchKibo.astro';
import Icon from '../../components/Icon.astro';
import GuideCard from '../../components/GuideCard.astro';
import EntityCard from '../../components/EntityCard.astro';
import Search from '../../components/Search.astro';
import Feedback from '../../components/Feedback.astro';
import FeatureVisual from '../../components/FeatureVisual.astro';
import ArtworkGallery from '../../components/ArtworkGallery.astro';
import ContentRoutes from '../../components/ContentRoutes.astro';
import CatalogHelp from '../../components/CatalogHelp.astro';
import UpdateFeed from '../../components/UpdateFeed.astro';
import { entityCategory } from '../../lib/entity-category.mjs';
import { isEntityCatalogPublishable } from '../../lib/entity-publication.mjs';
import { visibleGuides, allGuides, visibleEntitiesFor, isPublished, type ReferenceLocale as Locale } from '../../lib/content';
import { referenceLocales as locales, origin, languageTag } from '../../lib/publication.mjs';
import { t } from '../../lib/i18n';
import { sources } from '../../lib/facts';
export function getStaticPaths() {
  return ['zh-hans', 'ja'].flatMap((locale) => ['guides', 'systems', 'characters', 'kibo', 'updates', 'about', 'editorial-policy', 'contact', 'search'].map((page) => ({ params: { locale, page } })));
}
const locale = Astro.params.locale as Locale;
const page = Astro.params.page!;
const c = t(locale);
const ja = locale === 'ja';
const labels: Record<string, string> = { guides: c.guides, systems: c.systems, characters: c.characters, kibo: c.kibo, updates: c.updates, about: c.about, 'editorial-policy': c.policy, contact: c.contact, search: c.searchLabel };
const seoTitles: Record<string, string> = ja ? {
  guides: 'アズールプロミリア初心者攻略｜ダウンロード・容量・特典', systems: 'アズールプロミリアのシステム｜戦闘・キボ・農園', characters: 'アズールプロミリアのキャラ一覧｜公式紹介・中国本土ガチャ告知', kibo: 'アズールプロミリアのキボ一覧｜中国本土公式の24名・紹介画像', updates: 'アズールプロミリア攻略の更新情報｜地域・出典と変更履歴',
} : {
  guides: '蓝色星原开荒攻略｜下载、配置、公测福利与首抽', systems: '蓝色星原系统指南｜战斗、奇波与家园', characters: '蓝色星原角色一览｜官方介绍与国服公测卡池', kibo: '蓝色星原奇波图鉴｜24个官网名称与18份官方图像', updates: '蓝色星原攻略更新｜地区公告、来源与修订记录',
};
const intros: Record<string, string> = ja ? {
  guides: 'アズールプロミリアの配信日、公式ダウンロード、容量・推奨スペック、特典、リセマラ、ガチャとログイン対策を目的別に探せます。', systems: 'キボの入手、農園の生産、戦闘で困ったときの対処を探せます。', characters: '恒常ガチャの名簿、地域ごとのキャラ名と公式紹介を調べられます。', kibo: '中国本土公式の24名と18枚の紹介画像を地域別に整理し、既存の分類・生態資料も掲載します。名前のみの公開と入手可能なキボを区別します。', updates: '情報の変更点、対象範囲と確認状況を記録します。', about: '未知の世界を歩くための、プレイヤーによる非公式の道しるべ。', 'editorial-policy': '情報の根拠と対象範囲を示し、確認できていないことを区別します。', contact: '誤りや古い情報を見つけたら、根拠と一緒に修正メモを作成できます。', search: c.searchHelp,
} : {
  guides: '按问题查找蓝色星原官方下载、容量配置、公测福利、卡池保底、首抽与登录排查，分别核对国服和日本公告。', systems: '讲清操作、前提与例外，再把机制用到你的旅途中。', characters: '按星级查看国服常驻名单，查找各地区角色名称与官方介绍。', kibo: '按地区整理国服官网24个奇波名称与18份介绍图，区分名称展示和获取状态，并保留已有分类与生态资料。', updates: '记录改了什么、依据是什么，以及适用于哪个地区与版本。', about: '一份玩家自建的星原旅行手册，陪你走好每一次出发。', 'editorial-policy': '让已知有依据，让未知保持清楚，让每次修订都有迹可循。', contact: '如果发现错误或过时内容，可以在这里整理问题与可核对的依据。', search: c.searchHelp,
};
const entries = (await visibleGuides(locale)).filter((entry) => page === 'systems' ? entry.data.section === 'systems' : entry.data.section === 'guides');
const catalog = page === 'guides' || page === 'systems';
const entityKind = page === 'characters' ? 'character' : page === 'kibo' ? 'kibo' : null;
const entityEntries = entityKind ? visibleEntitiesFor(entityKind, locale) : [];
const characterFilters = [
  { id: 'all', label: c.filter.all, count: entityEntries.length },
  { id: 'fliss', label: c.filter.fliss, count: entityEntries.filter((e) => entityCategory(e) === 'fliss').length },
  { id: 'roselansa', label: c.filter.roselansa, count: entityEntries.filter((e) => entityCategory(e) === 'roselansa').length },
  { id: 'charles', label: c.filter.charles, count: entityEntries.filter((e) => entityCategory(e) === 'charles').length },
  { id: 'jiuzhou', label: c.filter.jiuzhou, count: entityEntries.filter((e) => entityCategory(e) === 'jiuzhou').length },
];
const kiboFilters = [
  { id: 'all', label: c.filter.all, count: entityEntries.length },
  { id: 'heteromorphic', label: c.filter.heteromorphic, count: entityEntries.filter((e) => entityCategory(e) === 'heteromorphic').length },
  { id: 'phantom', label: c.filter.phantom, count: entityEntries.filter((e) => entityCategory(e) === 'phantom').length },
];
const activeFilters: { id: string; label: string; count: number }[] = (entityKind === 'character' ? characterFilters : entityKind === 'kibo' ? kiboFilters : []).filter(filter => filter.id === 'all' || filter.count > 0);
const otherCount = entityEntries.filter(entity => entityCategory(entity) === 'other').length;
if (otherCount) activeFilters.push({ id: 'other', label: ja ? 'その他・未分類' : '其他／未分类', count: otherCount });
const all = await allGuides();
const noindex = ['search'].includes(page) || (catalog && entries.filter((e) => isPublished(e.data, all)).length < 2);
const alternateLocales = ['characters', 'kibo'].includes(page) ? [...locales, 'en' as const] : locales;
const alternates = alternateLocales.map((l) => ({ lang: languageTag[l], href: origin + `/${l}/${page}/` })).concat([{ lang: 'x-default', href: origin + `/zh-hans/${page}/` }]);
---
<Base locale={locale} title={seoTitles[page] || labels[page]} description={intros[page]} noindex={noindex} searchable={!['search', 'contact'].includes(page) && (!catalog || entries.length > 0)} alternates={alternates} languageTarget={`/${ja ? 'zh-hans' : 'ja'}/${page}/`}>
  <div class="container"><nav class="breadcrumb" aria-label={ja ? 'パンくずリスト' : '面包屑'}><a href={`/${locale}/`}>{c.home}</a><span>/</span>{labels[page]}</nav><header class="page-heading"><p class="eyebrow">PROMILIA FIELD NOTES</p><h1>{labels[page]}</h1><p>{intros[page]}</p></header>
    {catalog && <ContentRoutes locale={locale} entries={entries} section={page === 'systems' ? 'systems' : 'guides'}/>}
    {catalog && <p class="catalog-support"><a href={`/${locale}/faq/${page === 'systems' ? '#systems' : ''}`}>{ja ? 'よくある質問から探す' : '从常见问题找答案'} →</a> · <a href={`/${locale}/database/`}>{ja ? '図鑑の総合索引' : '图鉴总索引'} →</a></p>}
    {catalog && (entries.length ? <div class="catalog-list">{entries.map((entry, index) => <GuideCard entry={entry} index={index}/>)}</div> : <div class="empty-state"><Icon name="book" size={32}/><h2>{c.noContent}</h2><p>{c.noContentNote}</p><a class="text-link" href={`/${locale}/editorial-policy/`}>{c.policy}<Icon name="arrow" size={17}/></a></div>)}
    {page === 'search' && <><Search locale={locale}/><a class="text-link" href={`/${locale}/guides/`}>{c.browse}<Icon name="arrow" size={17}/></a></>}
    {entityKind && <FeatureVisual id={entityKind === 'character' ? 'character-meadow' : 'kibo-companions'} locale={locale} priority/>}
    {page === 'characters' && <BannerCharacters locale={locale}/>}
    {page === 'characters' && <LaunchRoster locale={locale}/>}
    {page === 'kibo' && <LaunchKibo locale={locale}/>}
    {entityKind && <section class="entity-catalog" data-entity-catalog={entityKind} data-pagefind-body>
      {entityKind === 'character' && <><h2>{ja ? '公測前の公式人物紹介資料' : '公测前官方人物介绍资料'}</h2><p class="notice">{ja ? '以下の5件は以前の公式紹介から照合した資料です。上の公測ガチャ対象とは別で、現在の全実装名簿ではありません。旧表記と現在の名称の対応は確認を続けています。' : '以下5项是此前核对的官方人物介绍，与上方公测卡池名单分别记录，不代表当前全部可用角色；旧表记与现名的对应继续核验。'}</p></>}
      <CatalogHelp locale={locale} kind={entityKind} count={entityEntries.filter(entity => isEntityCatalogPublishable(entity, locale, sources)).length}/>
      {entityKind === 'kibo' && <FeatureVisual id="kibo-showcase" locale={locale}/>}
      <div class="notice entity-notice">{ja ? '公式サイトの名称と紹介文を地域ごとの表記で掲載しています。スキルや素材は現在のゲーム内説明をご確認ください。' : '以下是官方名称与简介，保留各地区原名方便查找。技能和材料以当前游戏内说明为准。'}</div>
      {activeFilters.length > 0 && <div class="entity-filter-bar" role="group" aria-label={ja ? 'フィルター' : '分类筛选'}>
        {activeFilters.map((filter, i) => (
          <button type="button" class={`entity-filter-tab ${i === 0 ? 'active' : ''}`} data-filter-target={filter.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span>{filter.label}</span>
            <span class="filter-badge">{filter.count}</span>
          </button>
        ))}
      </div>}
      <div class="entity-grid">{entityEntries.map((entity, index) => <EntityCard entity={entity} locale={locale} index={index} source={sources.find((source) => source.id === entity.sourceRefs[locale])}/>)}</div>
      <script>
        const tabs = document.querySelectorAll<HTMLButtonElement>('.entity-filter-tab');
        const cards = document.querySelectorAll<HTMLElement>('.entity-card');
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const target = tab.dataset.filterTarget;
            tabs.forEach((t) => {
              const isActive = t === tab;
              t.classList.toggle('active', isActive);
              t.setAttribute('aria-pressed', String(isActive));
            });
            cards.forEach((card) => {
              const cat = card.dataset.entityCategory;
              if (target === 'all' || cat === target) {
                card.hidden = false;
              } else {
                card.hidden = true;
              }
            });
          });
        });
      </script>
      <div class="prose entity-editorial-note"><h2>{ja ? '出典と範囲' : '来源与范围'}</h2><p>{ja ? '名前、分類、公式紹介を掲載しています。スキル・育成・捕獲ルートの完全なガイドは含みません。' : '本目录提供名称、分类与官方介绍，完整技能、培养和捕获路线暂未收录。'}</p><a class="text-link" href={`/${locale}/updates/`}>{c.updates}<Icon name="arrow" size={17}/></a></div>
    </section>}
    {page === 'characters' && <ArtworkGallery kind="characters" locale={locale}/>}
    {page === 'kibo' && <section class="prose"><h2>{ja ? 'イラストで見るキボとの旅' : '插画中的奇波旅伴'}</h2><p>{ja ? 'キャラクターとキボが集う夜の一場面です。キボの名前や分類は上の図鑑で、入手方法はキボのシステムガイドで調べられます。' : '夜色中，角色与奇波聚在一起。上方图鉴可以查找名称和分类，奇波系统指南则整理了捕捉、蛋与活动领取的区别。'} <a href={`/${locale}/systems/kibo/`}>{ja ? 'キボの入手ガイド' : '查看奇波获取指南'} →</a></p><FeatureVisual id="kibo-night" locale={locale}/></section>}
    {page === 'updates' && <UpdateFeed locale={locale} entries={await visibleGuides(locale)} sources={sources}/>}
    {page === 'about' && <div class="narrow prose" data-pagefind-body><h2>{ja ? 'このサイトが目指すこと' : '我们希望解决的问题'}</h2><p>{ja ? 'Promilia Guide は、配信情報、準備の手順、ゲームの仕組みを探しやすくまとめる非公式ガイドです。読む人が「次に何をするか」と「どの地域・バージョンの情報か」を判断できるように整理します。' : 'Promilia Guide（星原旅伴）是面向简体中文、日语和英语读者的非官方攻略站。我们整理发行信息、准备步骤与机制说明，希望你读完能知道下一步做什么，以及信息适用于哪个地区和版本。英语版目前优先提供发行、下载、首日准备、福利与求助指南。'}</p><h2>{ja ? '情報との向き合い方' : '我们如何对待信息'}</h2><p>{ja ? '公式発表、テスト版の記録、編集上の提案、確認中の内容を区別します。AI による編集・翻訳支援を利用します。出典の照合、用語・表現の確認、プロジェクト責任者による公開判断を区別して記録し、公開判断を独立した言語校閲や実機検証の完了とは扱いません。架空のプレイ経験やレビュー担当者を記載しません。' : '官方已公布、测试观察、编辑建议和待核验内容分别标记。AI 可协助整理与翻译；来源核对、术语与表达检查、项目负责人发布确认分别记录，发布确认不等于独立语言审校或游戏实测完成。不虚构游玩经验、作者资历或审核人员。'}</p><h2>{ja ? '運営と権利について' : '非官方与版权说明'}</h2><p>{c.unofficial} {ja ? 'ゲーム名、商標、画像等の権利は各権利者に帰属します。サイト内の画像は、公式サイトで確認した素材とユーザー提供素材を分けて表示します。' : '游戏名称、商标及游戏素材权利属于相应权利人。站内图片会区分官网核对素材与用户提供素材，并分别标注。'}</p><h2>{ja ? 'プライバシー' : '隐私与本地记录'}</h2><p>{ja ? 'アカウント登録は不要です。チェックリストと手動の言語選択をブラウザーに保存します。現在、アクセス解析や広告用のトラッカーは導入していません。検索は配信済みの静的インデックスで処理します。' : '本站无需注册。清单进度和手动语言选择保存在浏览器本地；目前未接入统计、广告追踪或第三方字体。搜索在已部署的静态索引中执行。'}</p><p><a href={`/${locale}/editorial-policy/`}>{c.policy}</a> · <a href={`/${locale}/contact/`}>{c.contact}</a></p></div>}
    {page === 'editorial-policy' && <div class="narrow prose" data-pagefind-body><h2>{ja ? '結論の種類を明記する' : '先说明结论的性质'}</h2><ul><li><strong>{c.official}</strong> — {ja ? '原文と対象範囲を確認した公式発表。' : '回溯原始公告并核对适用范围的事实。'}</li><li><strong>{c.test}</strong> — {ja ? 'バージョンと条件を記録したテストの観察。正式版とは区別します。' : '有版本与复核条件的测试记录，不自动套用到公测。'}</li><li><strong>{c.editorial}</strong> — {ja ? '前提と理由を説明した手順や提案。ゲーム内の保証ではありません。' : '说明前提与原因的行动建议，不冒充官方规则。'}</li><li><strong>{c.pending}</strong> — {ja ? '原文未確認や矛盾が残る項目。確定情報として扱いません。' : '来源未录入、存在冲突或证据不足的内容。'}</li></ul><h2>{ja ? '出典と日付' : '来源和日期分别记录'}</h2><p>{ja ? '発表者、URL、掲載日、照合日、対象バージョンを記録します。動画は必要な時刻も記載します。出典を再確認した日だけでは、記事の内容更新日を変更しません。企画書や競合調査は、ゲームの公式根拠にはなりません。' : '来源记录发布者、原始链接、发布日期、核对日期和适用版本；视频保留相关时间点。仅检查来源没有实质变动时，不刷新文章更新时间。项目规划和竞品研究不能替代游戏官方证据。'}</p><h2>{ja ? '言語とサーバーを区別する' : '语言与服务器独立'}</h2><p>{ja ? '日本語の記事が日本向けサーバーを説明するとは限りません。各ページに地域とバージョンを表示します。翻訳には原稿の改訂番号を記録し、重要な変更があれば再レビューします。未公開の翻訳へのリンクは生成しません。' : '日语文章可以讨论中国大陆服，但必须标明地区和版本。译文记录原稿修订号；重大事实变化后重新审核。未发布的译文不会生成替代语言链接。'}</p><h2>{ja ? '公開前の確認' : '发布前的必要审核'}</h2><ol><li>{ja ? '見出しの疑問に本文が答え、読者が使える手順になっているか。' : '标题承诺的问题有答案，步骤与适用条件完整。'}</li><li>{ja ? '判断に影響する事実に、原文と対象範囲があるか。' : '关键事实有原始证据，冲突和未知项可见。'}</li><li>{ja ? '用語・表現の確認と公開判断の記録があり、独立した校閲・実機検証と区別されているか。' : '完成名称与语言表达检查，记录真实发布确认与日期，并与独立语言审校、游戏实测区分。'}</li><li>{ja ? 'リンク、検索、モバイル表示、索引設定が正しいか。' : '构建、内链、搜索、手机展示和索引设置通过检查。'}</li></ol><h2>{ja ? '訂正と素材の相談' : '纠错与素材反馈'}</h2><p>{ja ? '誤りは根拠を確認して修正し、理由と影響範囲を履歴に残します。素材の権利に関する相談では、該当 URL と権利を確認できる資料を添えてください。' : '错误经过核对后修订，记录变更原因与影响范围。素材权利反馈请附具体 URL 与可确认权利关系的资料。'}</p><a href={`/${locale}/contact/`}>{c.contact} →</a></div>}
    {page === 'contact' && <div class="narrow"><Feedback locale={locale}/><p class="search-help">{ja ? 'パスワード、認証コード、個人を特定できる情報は記入しないでください。' : '请勿填写密码、验证码或不必要的个人信息。'}</p><a class="text-link" href={`/${locale}/editorial-policy/`}>{c.policy}<Icon name="arrow" size={17}/></a></div>}
  </div>
</Base>
