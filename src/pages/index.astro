---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { origin } from '../lib/publication.mjs';
const alternates = [{ lang: 'zh-Hans', href: origin + '/zh-hans/' }, { lang: 'ja', href: origin + '/ja/' }, { lang: 'en', href: origin + '/en/' }, { lang: 'x-default', href: origin + '/' }];
---
<Base locale="en" title="Choose language / 选择语言 / 言語を選択" description="Promilia Guide · 蓝色星原：旅谣非官方攻略 / Azur Promilia 非公式ガイド / English release, download and requirements guides" alternates={alternates} searchable={false}>
  <div class="language-landing container"><div class="landing-emblem"><Icon name="star" size={46}/></div><p class="eyebrow">YOUR JOURNEY, YOUR LANGUAGE</p><h1>Every journey<br/>begins with a <em>little guidance.</em></h1><p><span lang="zh-Hans">选择你的语言，开始星原之旅。</span><br/><span lang="ja">言語を選んで、星原への旅を始めましょう。</span></p><div class="language-options"><a href="/zh-hans/" data-language-choice="zh-hans" lang="zh-Hans"><small>01 / ZH-HANS</small><strong>简体中文</strong><span>星原旅伴<Icon name="arrow" size={20}/></span></a><a href="/ja/" data-language-choice="ja" lang="ja"><small>02 / JA</small><strong>日本語</strong><span>Promilia Guide<Icon name="arrow" size={20}/></span></a><a href="/en/" data-language-choice="en" lang="en"><small>03 / EN</small><strong>English</strong><span>Promilia Guide<Icon name="arrow" size={20}/></span></a></div><p class="language-suggestion" id="language-suggestion" aria-live="polite"></p></div>
  <script>
    let preferred: string | null = null;
    try { preferred = localStorage.getItem('promilia:language'); } catch { /* Browser preference is optional. */ }
    if (!['zh-hans', 'ja', 'en'].includes(preferred || '')) preferred = navigator.language.toLowerCase().startsWith('ja') ? 'ja' : navigator.language.toLowerCase().startsWith('en') ? 'en' : 'zh-hans';
    document.querySelector(`.language-options [data-language-choice="${preferred}"]`)?.classList.add('suggested-language');
    const hint = document.getElementById('language-suggestion');
    if (hint) hint.textContent = preferred === 'en' ? 'English is suggested. You can change language at any time.' : preferred === 'ja' ? '日本語をおすすめしています。言語はいつでも変更できます。' : '推荐简体中文。你可以随时切换语言。';
  </script>
</Base>
