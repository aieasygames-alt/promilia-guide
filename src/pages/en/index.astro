---
import Base from '../../layouts/Base.astro';
import ArtworkGallery from '../../components/ArtworkGallery.astro';
import { visuals, visualSrcSet } from '../../lib/visuals';
import Icon from '../../components/Icon.astro';
import GuideCard from '../../components/GuideCard.astro';
import { visibleGuides } from '../../lib/content';
import { locales, languageTag, origin } from '../../lib/publication.mjs';
const entries = await visibleGuides('en');
const groups = [
  { id: 'prepare', title: 'Choose your version and get online', description: 'Regional dates, supported devices, cross-save and help when installation or login fails.', topics: ['global-release', 'launch', 'download', 'requirements', 'platforms', 'cloud-gaming', 'support'] },
  { id: 'account-rewards', title: 'First pulls, rewards and account choices', description: 'Keep banner counts, selector milestones and regional claim conditions separate.', topics: ['getting-started', 'resources', 'reroll', 'banner-rules', 'redeem-codes', 'recharge-return'] },
  { id: 'gameplay', title: 'Build your team, farm and Kibo collection', description: 'Practical troubleshooting and attributed community ideas for your next session.', topics: ['combat', 'home', 'kibo-guide'] },
];
const alternates = [...locales.map(locale => ({ lang: languageTag[locale], href: `${origin}/${locale}/` })), { lang: 'x-default', href: origin + '/' }];
---
<Base locale="en" title="Azur Promilia Guide: Teams, Kibo, Farming & Downloads" description="English Azur Promilia guides for regional downloads, cross-save, starter teams, five-star selectors, farm seeds, Kibo capture, launch rewards and support." alternates={alternates}>
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow">AZUR PROMILIA · ENGLISH GUIDES</p><h1><span class="hero-game">Azur Promilia Guide</span>A new world.<br/><em>A clearer way in.</em></h1><p class="hero-intro">Find the right regional version, prepare your device and account, then plan first pulls, build a team, manage farm production and explore Kibo capture.</p><div class="hero-actions"><a class="button" href="/en/guides/global-release/">Release dates & regions<Icon name="arrow" size={18}/></a><a class="hero-secondary" href="#guides">Browse guides</a></div><div class="hero-note"><span class="note-rule"></span><span>Regional sources · Clear dates · Practical steps</span></div></div>
    <div class="hero-visual"><img src="/images/feature/home-world.webp" srcset={visualSrcSet('home-world')} sizes="(max-width: 900px) 100vw, 55vw" width="1500" height="843" alt={visuals['home-world'].alt.en} fetchpriority="high" loading="eager" decoding="async"/><div class="visual-coordinate" aria-hidden="true">PROMILIA FIELD NOTES<br/>VOL. 01 — A NEW JOURNEY</div><div class="visual-caption"><span class="caption-symbol">✧</span><span><small>BEFORE YOU SET OUT</small><strong>A little preparation goes a long way.</strong></span></div></div>
  </section>
  <div class="container">
    <section class="notice english-scope" aria-labelledby="regional-status"><h2 id="regional-status">Regional launches, SEA and the English release</h2><p>Japan and mainland China announced service began on <strong>November 26, 2026</strong>. Korea and the Traditional Chinese edition also display November 26 launch announcements or banners. Check current regional notices for maintenance and personal login issues.</p><p>The official English account <a href="https://x.com/AzurPromilia_EN/status/2109992558004998420" target="_blank" rel="noopener noreferrer">targets summer 2027, subject to change</a>. PlayPark SEA is a separate service taking preregistrations, with English among five announced interface languages. Sources were checked November 28. This guide’s language does not change the game edition or its account and language rules. <a href="/en/guides/global-release/">Compare regional versions →</a></p></section>
    <section class="home-section" id="guides" aria-labelledby="guides-title"><div class="section-head"><div><p class="section-kicker">FROM FIRST LOGIN TO YOUR NEXT SESSION</p><h2 id="guides-title">Find the guide for what you need next</h2><p>Start with your regional version, then compare team choices, keep farm production running and plan Kibo captures.</p></div></div>{groups.map(group => <section class="english-guide-group" id={group.id} aria-labelledby={`${group.id}-title`}><h3 id={`${group.id}-title`}>{group.title}</h3><p>{group.description}</p><div class="guide-grid">{group.topics.flatMap(id => entries.filter(entry => entry.data.contentId === id)).map((entry, index) => <GuideCard entry={entry} index={index}/>)}</div></section>)}</section>
    <p class="notice">Need a quick answer? <a href="/en/faq/">Browse the English FAQ</a>, check <a href="/en/characters/">the China launch character roster</a> and <a href="/en/kibo/">official Kibo names and artwork</a>, read about <a href="/en/guides/cloud-gaming/">China cloud gaming on Mac</a>, or prepare a report with <a href="/en/guides/support/">official support guidance</a>.</p>
    <section class="home-section english-info" id="about"><div><p class="section-kicker">ABOUT PROMILIA GUIDE</p><h2>An independent guide for your next journey</h2><p>Promilia Guide is an unofficial fan site maintained by an independent developer. It is not affiliated with Manjuu, Yostar or the regional publishers. Our English section covers regional releases, downloads, cross-save, first pulls, team ideas, farm production, Kibo capture, rewards and official support. More reference material is available in <a href="/zh-hans/" lang="zh-Hans">简体中文</a> and <a href="/ja/" lang="ja">日本語</a>.</p></div><div id="editorial-policy"><h2>How we check information</h2><p>Each guide links to original regional sources and records when those sources were checked. Japan and China rules are kept separate. An official announcement, an accessible store listing, a downloaded installer and a successful game login are different checks.</p><p>The original regional checks are dated in each guide. The English edition began on November 25, 2026; post-launch banner and event updates were added on November 27, followed by team, farm and Kibo guides on November 28. We have not completed installation or gameplay tests.</p></div><div id="corrections"><h2>Report a correction</h2><p>If you find an error, include the guide URL, the regional version, the affected passage and a link to the official announcement. You can <a href="https://github.com/aieasygames-alt/promilia-guide/issues/new" target="_blank" rel="noopener noreferrer">open a correction issue on GitHub</a> (a GitHub account is required). Please leave out account passwords, verification codes and other private information.</p><p>Search runs in your browser using the site's static index. Language choices are saved in local storage. This site has no game account login; official downloads and support links lead to external services with their own policies.</p></div></section>
    <ArtworkGallery kind="home" locale="en"/>
  </div>
</Base>
<style>
  .english-scope { display: block; margin: 2rem 0; line-height: 1.9; }
  .hero-game { display: block; font: 600 1rem/1.6 var(--font-body, sans-serif); color: var(--green); margin-bottom: 1rem; }
  .english-scope p strong { display: inline; }
  .english-scope h2 { font-size: 1.3rem; margin-bottom: .8rem; }
  .english-scope p + p { margin-top: .8rem; }
  .english-scope a, .english-info a { text-decoration: underline; text-underline-offset: .2em; }
  .english-info { display: grid; gap: 2.5rem; max-width: 850px; padding-bottom: 3rem; line-height: 1.9; }
  .english-info h2 { margin-bottom: .8rem; }
  .english-info p + p { margin-top: .7rem; }
  .english-guide-group + .english-guide-group { margin-top: 2.5rem; }
  .english-guide-group > h3 { font-size: 1.4rem; margin-bottom: .5rem; }
  .english-guide-group > p { color: var(--muted); margin-bottom: 1.2rem; line-height: 1.7; }
  .english-guide-group .guide-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  [id] { scroll-margin-top: 7rem; }
</style>
