---
import { claims as defaultClaims, sources as defaultSources } from '../lib/facts';
import { regionalReleaseState } from '../lib/release-state.mjs';
import { redeemCodes } from '../lib/redeem-data';
import { redeemCodeRows, announcedCodeRows } from '../lib/redeem-codes.mjs';
import ScheduleTime from './ScheduleTime.astro';
interface Props { locale: 'zh-hans' | 'ja'; claimData?: typeof defaultClaims; sourceData?: typeof defaultSources }
const { locale, claimData: claims = defaultClaims, sourceData: sources = defaultSources } = Astro.props;
const ja = locale === 'ja';
const regions = (ja ? ['jp', 'cn'] as const : ['cn', 'jp'] as const).map(region => regionalReleaseState({ claims, sources, region }));
const codeCount = redeemCodeRows({ codes: redeemCodes, sources }).filter(code => code.status === 'active').length;
const announcedCount = announcedCodeRows({ codes: redeemCodes, sources }).length;
---
<section class="launch-actions" aria-labelledby="launch-actions-title" data-launch-actions>
  <header><p class="eyebrow">YOUR NEXT STEP</p><h2 id="launch-actions-title">{ja ? '利用する地域の配信情報' : '查看所玩地区的开服与下载信息'}</h2><p>{ja ? '日本版と中国本土版の告知日程とダウンロード先を掲載しています。' : '国服与日服的公告时间、上线状态和官方下载入口。'}</p></header>
  <div class="launch-region-grid">
    {regions.map(region => <article class="launch-region" data-launch-region={region.region} data-service-stage={region.stage}>
      <h3>{region.region === 'cn' ? (ja ? '中国本土' : '中国大陆') : (ja ? '日本' : '日本地区')}</h3>
      <dl>
        <div><dt>{ja ? '当初の開始時刻' : '原定开服时间'}</dt><dd><ScheduleTime schedule={region.launch} locale={locale}/></dd></div>
        <div><dt>{region.preloadAnnounced ? (ja ? '事前DL開始（公式発表）' : '预下载开始（官方公告）') : (ja ? '事前ダウンロード予定' : '预下载计划')}</dt><dd><ScheduleTime schedule={region.preload} locale={locale}/></dd></div>
      </dl>
      {region.launch?.instant && !['open', 'maintenance'].includes(region.stage) && <p class="launch-clock" data-launch-clock={region.launch.instant} data-clock-locale={locale} role="status" hidden></p>}
      <p class="search-help">{region.stage === 'open' ? (ja ? '11月26日の公式告知で正式サービス開始を確認。現在のメンテナンスや個別ログイン状態は最新のお知らせへ。' : '已核对11月26日正式上线公告。当前维护与个人登录状态请查最新公告。') : region.stage === 'maintenance' ? (ja ? 'メンテナンスの公式情報を確認してください。' : '请核对当前维护公告。') : region.launch?.time ? (ja ? '上記は公式の開始予定です。実際の稼働状況は当日のお知らせで確認してください。' : '以上为官方计划时刻，实际开放状态请核对当日公告。') : (ja ? '具体的な時刻とログイン可能な状態は、公式情報で別途確認します。' : '具体小时与是否可登录，仍需对应地区的独立官方依据。')}</p>
      <a class="text-link" href={`/${locale}/guides/download/?region=${region.region}`}>{ja ? 'この地域の端末・公式入口' : '查看该地区的设备与官方入口'} →</a>
    </article>)}
  </div>
  <p class="launch-code-note" data-home-code-count>{codeCount ? (ja ? `掲載中のコードは${codeCount}件です。入力場所と期限をご確認ください。` : `已收录${codeCount}组兑换码，可查看输入方法与有效期。`) : announcedCount ? (ja ? '日本版の公式コード AZPR1126 を掲載しています。入力方法と期限はこちら。' : '日服兑换码 AZPR1126 已公布，可查看输入方法与公告期限。') : (ja ? '現在、有効と確認できたシリアルコードはありません。' : '当前暂无可独立核验的有效兑换码。')} <a href={`/${locale}/guides/redeem-codes/`}>{ja ? 'コードの詳細 →' : '查看兑换码详情 →'}</a></p>
</section>
<script>
  import { countdownText } from '../lib/release-state.mjs';
  document.querySelectorAll<HTMLElement>('[data-launch-clock]').forEach(clock => {
    const instant = clock.dataset.launchClock!;
    const locale = clock.dataset.clockLocale === 'ja' ? 'ja' : 'zh-hans';
    const update = () => { clock.textContent = countdownText(instant, new Date(), locale); clock.hidden = false; };
    update();
    window.setInterval(update, 60000);
  });
</script>
<style>
  .launch-actions { margin: 1.5rem 0 2rem; padding: clamp(1.2rem, 3vw, 2rem); border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); }
  .launch-actions header h2 { margin: .3rem 0; font-size: 1.5rem; }
  .launch-actions header p { color: var(--muted); }
  .launch-region-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1rem; margin-top: 1.3rem; }
  .launch-region { padding: 1.2rem; border: 1px solid var(--line); border-radius: .6rem; min-width: 0; }
  .launch-region h3 { margin: 0 0 .8rem; }
  .launch-region dl { margin: 0; }
  .launch-region dl div { display: flex; flex-wrap: wrap; gap: .3rem 1rem; justify-content: space-between; margin-bottom: .6rem; }
  .launch-region dt { color: var(--muted); font-size: .85rem; }
  .launch-region dd { margin: 0; }
  .launch-clock { font-variant-numeric: tabular-nums; }
  .launch-code-note { font-size: .85rem; color: var(--muted); margin: 1rem 0 0; }
  @media (max-width: 640px) { .launch-region-grid { grid-template-columns: 1fr; } }
</style>
