---
import type { createReleaseReport } from '../lib/release-readiness.mjs';
interface Props { report: ReturnType<typeof createReleaseReport> }
const { report } = Astro.props;
const topics = [...new Set(report.articles.map((article) => article.contentId))];
---
<section class="release-readiness" id="release-readiness" data-release-ready={String(report.ready)}>
  <header><div><p class="eyebrow">FIRST RELEASE</p><h2>首批发布检查</h2><p>五个核心主题，中日文各五篇。待核验项需明确说明；正文、语言与来源完成真实审核后才计为可发布。</p></div><button class="button secondary" type="button" id="download-release-report">下载首发报告</button></header>
  <div class="release-progress"><strong data-release-count>{report.summary.ready} / {report.summary.required}</strong><span>篇可发布</span><meter min="0" max={report.summary.required} value={report.summary.ready} aria-label="首批可发布稿件"/><span>{report.ready ? '内容检查已就绪' : `待人工审核 ${report.summary.awaitingReview} · 缺稿 ${report.summary.missing} · 需同步 ${report.summary.stale}`}</span></div>
  {report.validationIssues.length > 0 && <div class="notice"><strong>内容关系检查未通过</strong><ul>{report.validationIssues.map((issue) => <li>{issue}</li>)}</ul></div>}
  <div class="release-table-scroll"><table><thead><tr><th scope="col">核心主题</th>{report.locales.map((item) => <th scope="col">{item.locale === 'ja' ? '日语' : '简体中文'} · {item.ready}/{item.required}</th>)}</tr></thead><tbody>{topics.map((id) => <tr><th scope="row">{report.articles.find((article) => article.contentId === id)!.label}</th>{report.locales.map(({ locale }) => {
    const article = report.articles.find((article) => article.contentId === id && article.locale === locale)!;
    return <td data-release-article={`${id}:${locale}`}><span class={`pill ${article.ready ? '' : 'pending'}`}>{article.ready ? '可发布' : article.url ? '待处理' : '缺少稿件'}</span>{article.url && <a href={article.url}>{article.title} ↗</a>}<details><summary>{article.blockers.length} 项发布阻碍 · {article.warnings.length} 项核验提醒</summary><ul>{article.blockers.map((issue) => <li>{issue.message}</li>)}{article.warnings.map((issue) => <li class="release-warning">提醒：{issue.message}</li>)}{!article.blockers.length && !article.warnings.length && <li>未发现内容发布阻碍</li>}</ul></details></td>;
  })}</tr>)}</tbody></table></div>
  <p class="release-help"><code>content:readiness</code> 生成只读报告；<code>release:check</code> 未就绪时返回失败；<code>build:release</code> 先通过首发检查再生成正式产物。内容检查不替代部署、真机或目标网络验收。</p>
  <p id="release-report-status" role="status" aria-live="polite"></p>
</section>
<style>
  .release-readiness{margin-top:42px;padding:26px;border:1px solid var(--line);background:var(--card)}.release-readiness>header{display:flex;justify-content:space-between;gap:24px;align-items:center}.release-readiness h2{font:500 27px var(--serif);margin:8px 0 10px}.release-readiness header p:last-child{font-size:12px;color:var(--muted);max-width:680px}.release-readiness .eyebrow{font-size:10px}.release-readiness header button{flex-shrink:0}.release-progress{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:24px 0}.release-progress strong{font:28px var(--serif)}.release-progress span{font-size:11px;color:var(--muted)}.release-progress meter{width:180px;max-width:100%;accent-color:var(--green)}.release-table-scroll{overflow-x:auto;border:1px solid var(--line)}.release-readiness table{width:100%;border-collapse:collapse;font-size:12px}.release-readiness th{text-align:left;font-weight:500;padding:16px;min-width:110px}.release-readiness thead{background:var(--mint)}.release-readiness td{padding:16px;min-width:230px;width:40%;vertical-align:top}.release-readiness tbody th,.release-readiness td{border-top:1px solid var(--line)}.release-readiness td>a{display:block;color:var(--green);margin:9px 0;font-size:13px}.release-readiness summary{cursor:pointer;color:var(--muted);font-size:11px}.release-readiness ul{padding-left:17px;margin:12px 0 0}.release-readiness li{margin:7px 0}.release-warning{color:var(--muted)}.release-help,#release-report-status{font-size:11px;color:var(--muted);line-height:1.9;margin-top:18px;overflow-wrap:anywhere}@media(max-width:650px){.release-readiness{padding:20px}.release-readiness>header{display:block}.release-readiness header button{margin-top:18px}.release-progress{gap:12px}.release-progress meter{width:100%}}
</style>
