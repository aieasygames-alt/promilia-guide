---
import { sources } from '../lib/facts';
interface Props { locale: 'zh-hans' | 'ja' | 'en' }
const { locale } = Astro.props;
const copy = {
  'zh-hans': {
    title: '先选游戏地区，再选下载设备',
    intro: 'Promilia Guide 是玩家攻略站。下面直接前往各地区官网；攻略语言不会改变游戏地区。',
    regions: ['日本 / 日服', '中国大陆 / 国服', '繁中版', '韩国 / 韩服', 'SEA / 东南亚版', '英语版计划'],
    notes: ['PC从日本Windows专页开始；手机从日本官网进入商店。', '官方服与渠道账号先分清，再选对应客户端。', '已显示11月26日正式公测与PC、手机官方下载按钮。', 'Nexon官网显示11月26日GRAND OPEN及PC、移动商店入口。', 'PlayPark独立运营，当前官网为预约；FAQ列出含英语在内的5种界面语言。', '官方目标2027年夏季，可能调整；不作为SEA版日期。'],
    official: '查看官方入口／公告', pc: '日本Windows官方下载页', steps: '安装与账号步骤',
    devices: ['PC步骤', 'Android步骤', 'iPhone / iPad核对'], evidence: '官方来源与日期',
    unknown: '“国际服”需区分SEA与英语版计划；SEA支持简中不代表日服支持中文。先核对版本，再查游戏内语言与账号条件。',
  },
  ja: {
    title: 'プレイする地域を選び、公式からダウンロード',
    intro: 'Promilia Guideは非公式の攻略サイトです。以下は各地域の公式サイトへのリンクです。記事の言語とゲームの地域は別に選びます。',
    regions: ['日本版', '中国本土版', '繁体字版', '韓国版', 'SEA / 東南アジア版', '英語版の予定'],
    notes: ['PCは日本公式Windowsページ、スマホは日本公式のストアリンクへ。', '公式版と配布元別アカウントの違いを確認してから取得します。', '11月26日開始とPC・スマホの公式ダウンロードを表示。', 'Nexon公式に11月26日GRAND OPENとPC・各ストアの入口を確認。', 'PlayParkが独立運営。現在は事前登録で、英語を含む5表示言語を案内。', '公式の目標時期は2027年夏。変更の可能性があり、SEA版の日程とは別です。'],
    official: '公式の入口・告知へ', pc: '日本公式Windowsダウンロード', steps: '導入とアカウントの手順',
    devices: ['PCの手順', 'Androidの手順', 'iPhone / iPadの確認'], evidence: '公式出典と日付',
    unknown: 'SEA版と英語版の予定は別に確認してください。SEA版の中国語対応は、日本版の中国語対応を意味しません。利用資格とゲーム内言語も各版で確認します。',
  },
  en: {
    title: 'Choose your regional edition, then your device',
    intro: 'Promilia Guide is an unofficial guide site. These links lead to regional official sites; the language of this guide does not select a game region.',
    regions: ['Japan edition', 'Mainland China edition', 'Traditional Chinese edition', 'Korea edition', 'SEA edition', 'English release plan'],
    notes: ['Start on the Japan Windows page for PC, or follow mobile-store links from the Japan homepage.', 'Check official-server versus channel-account rules before choosing a client.', 'The site now displays November 26 launch and official PC/mobile download buttons.', 'Nexon displays November 26 GRAND OPEN with PC and mobile-store entries.', 'PlayPark operates this edition independently. The site offers preregistration and lists five interface languages including English.', 'The official target is summer 2027, subject to change. This is separate from the SEA schedule.'],
    official: 'Official entry / announcement', pc: 'Official Japan Windows page', steps: 'Installation and account steps',
    devices: ['PC steps', 'Android steps', 'iPhone / iPad checks'], evidence: 'Official sources and dates',
    unknown: 'SEA and the English release plan are separate. SEA language support does not establish English or Chinese text in the Japan client. Check each edition’s account eligibility and language options.',
  },
}[locale];
const sourceIds = ['jp-official-home-2026-11-14', 'cn-official-home-2026-11-14', 'tc-official-launch-2026-11-28', 'kr-official-launch-2026-11-28', 'sea-official-home-2026-11-28', 'en-release-window-2026-10-13'];
function officialUrl(id: string) {
  const source = sources.find(source => source.id === id);
  if (!source || source.status !== 'verified' || source.kind !== 'official' || !source.url?.startsWith('https://')) throw new Error(`Unverified gateway entry: ${id}`);
  return source.url;
}
const pcUrl = officialUrl('jp-pc-download-page-2026-11-24');
const regions = ['jp', 'cn', 'tc', 'kr', 'sea', 'en'];
const englishTargets = ['how-to-download-the-japan-version-on-pc', 'how-to-download-on-android-or-iphone', 'how-to-download-on-android-or-iphone'];
---
<section class="regional-gateway" aria-labelledby="regional-gateway-title" data-regional-gateway>
  <h2 id="regional-gateway-title">{copy.title}</h2>
  <p>{copy.intro}</p>
  <div class="region-cards">{sourceIds.map((id, index) => <section data-region-entry={regions[index]}>
    <h3>{copy.regions[index]}</h3><p>{copy.notes[index]}</p>
    <a class="official-entry" href={officialUrl(id)} rel="noopener noreferrer" target="_blank">{copy.official} ↗</a>
    {index === 0 && <a href={pcUrl} rel="noopener noreferrer" target="_blank">{copy.pc} ↗</a>}
    {index < 2 && <ul>{['pc', 'android', 'ios'].map((platform, device) => <li><a href={locale === 'en' ? `/en/guides/download/#${index === 1 ? 'china-client-accounts-and-old-test-versions' : englishTargets[device]}` : `/${locale}/guides/download/?region=${regions[index]}&platform=${platform}#distribution-title`}>{copy.devices[device]}</a></li>)}</ul>}
    <a class="evidence" href={`#source-${id}`}>{copy.evidence}</a>
  </section>)}</div>
  <p class="region-boundary">{copy.unknown} <a href={`/${locale}/guides/getting-started/`}>{copy.steps} →</a></p>
</section>
<style>
  .regional-gateway { margin: 0 0 2rem; padding: 1.2rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper, #fffdf8); }
  h2 { font-size: 1.35rem; margin: 0 0 .6rem; }
  p { line-height: 1.7; color: var(--muted); margin: .5rem 0 1rem; }
  .region-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .region-cards section { min-width: 0; border-top: 2px solid var(--green); padding-top: .8rem; }
  h3 { margin: 0 0 .5rem; font-size: 1.1rem; }
  a { color: var(--green); text-decoration: underline; text-underline-offset: .2em; overflow-wrap: anywhere; }
  .region-cards > section > a { display: block; width: fit-content; margin: .5rem 0; }
  .official-entry { font-weight: 700; }
  ul { padding: 0; margin: .8rem 0; list-style: none; display: flex; flex-wrap: wrap; gap: .6rem .8rem; }
  .evidence { font-size: .8rem; }
  .region-boundary { margin: 1rem 0 0; font-size: .9rem; }
  @media (max-width: 760px) { .region-cards { grid-template-columns: 1fr; } }
</style>
