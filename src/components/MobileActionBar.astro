---
import Icon from './Icon.astro';
import { t } from '../lib/i18n';
import type { Locale } from '../lib/content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale);
const ja = locale === 'ja';
const copyFailed = locale === 'en' ? 'Could not copy the link. Copy it from your address bar.' : ja ? 'リンクをコピーできませんでした。アドレスバーからコピーしてください。' : '复制未成功，请从浏览器地址栏复制链接。';
---
<aside class="mobile-action-bar" aria-label={locale === 'en' ? 'Quick actions' : ja ? 'クイック操作' : '快捷操作'}>
  <div class="mobile-bar-inner">
    <a href="#article-toc" class="mobile-bar-btn" id="mobile-toc-btn" aria-label={c.mobileBar.toc}>
      <Icon name="toc" size={17} /><span>{c.mobileBar.toc}</span>
    </a>
    <button type="button" class="mobile-bar-btn" id="mobile-share-btn" aria-label={c.mobileBar.share} data-copied={c.mobileBar.copied} data-failed={copyFailed} hidden>
      <Icon name="share" size={17} /><span class="share-text">{c.mobileBar.share}</span>
    </button>
    <a href="#main" class="mobile-bar-btn" id="mobile-top-btn" aria-label={c.mobileBar.top}>
      <Icon name="arrowUp" size={17} /><span>{c.mobileBar.top}</span>
    </a>
  </div>
  <p class="mobile-share-status" role="status" aria-live="polite"></p>
</aside>
<script>
  const tocBtn = document.getElementById('mobile-toc-btn');
  const shareBtn = document.getElementById('mobile-share-btn');
  const topBtn = document.getElementById('mobile-top-btn');
  const status = document.querySelector<HTMLElement>('.mobile-share-status');
  const scrollBehavior = () => matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' as const : 'smooth' as const;
  tocBtn?.addEventListener('click', (event) => {
    const toc = document.getElementById('article-toc');
    if (!toc) return;
    event.preventDefault();
    const mobileToc = toc.querySelector<HTMLDetailsElement>('[data-mobile-toc]');
    if (mobileToc) mobileToc.open = true;
    toc.scrollIntoView({ behavior: scrollBehavior(), block: 'start' });
    (mobileToc?.querySelector('summary') || toc).focus({ preventScroll: true });
  });
  topBtn?.addEventListener('click', (event) => {
    event.preventDefault();
    const main = document.getElementById('main');
    main?.setAttribute('tabindex', '-1');
    main?.focus({ preventScroll: true });
    window.scrollTo({ top: 0, behavior: scrollBehavior() });
  });
  if (shareBtn) {
    shareBtn.hidden = false;
    const textSpan = shareBtn.querySelector('.share-text');
    const originalText = textSpan?.textContent || '';
    let reset: ReturnType<typeof setTimeout>;
    shareBtn.addEventListener('click', async () => {
      clearTimeout(reset);
      try {
        if (navigator.clipboard) {
          await navigator.clipboard.writeText(window.location.href);
        } else {
          const input = document.createElement('input');
          input.value = window.location.href;
          document.body.appendChild(input);
          input.select();
          let copied = false;
          try { copied = document.execCommand('copy'); } finally { input.remove(); }
          if (!copied) throw new Error('Copy failed');
        }
        const feedback = shareBtn.dataset.copied || 'OK';
        if (textSpan) textSpan.textContent = feedback;
        if (status) status.textContent = feedback;
        shareBtn.classList.add('copied');
        reset = setTimeout(() => {
          if (textSpan) textSpan.textContent = originalText;
          shareBtn.classList.remove('copied');
          if (status) status.textContent = '';
        }, 2000);
      } catch {
        if (textSpan) textSpan.textContent = originalText;
        shareBtn.classList.remove('copied');
        if (status) status.textContent = shareBtn.dataset.failed || '';
      }
    });
  }
</script>
