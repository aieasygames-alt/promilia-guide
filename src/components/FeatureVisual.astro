---
import type { Locale } from '../lib/content';
import { visuals, visualSrcSet, type VisualId } from '../lib/visuals';
interface Props { id: VisualId; locale: Locale; priority?: boolean; sizes?: string; }
const { id, locale, priority = false, sizes } = Astro.props;
const visual = visuals[id];
---
<figure class={`site-visual site-visual-${id}`} data-visual-id={id} style={`max-width:${Math.min(visual.width, 960)}px`}>
  <img src={visual.src} srcset={visualSrcSet(id)} sizes={sizes || `(max-width: 650px) calc(100vw - 40px), ${Math.min(visual.width, 960)}px`} alt={visual.alt[locale]} width={visual.width} height={visual.height} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined}/>
  <figcaption>{visual.caption[locale]}</figcaption>
</figure>
