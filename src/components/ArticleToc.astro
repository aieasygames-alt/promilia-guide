---
import type { Locale } from '../lib/content';
import { t } from '../lib/i18n';
interface Props { locale: Locale; items: { id: string; text: string }[] }
const { locale, items } = Astro.props;
const label = t(locale).articleIndex;
---
<aside class="article-toc" id="article-toc" tabindex="-1" data-pagefind-ignore>
  <div class="toc-desktop"><h2>{label}</h2><nav aria-label={label}>{items.map((item) => <a href={`#${item.id}`}>{item.text}</a>)}</nav></div>
  <details class="toc-mobile" data-mobile-toc><summary>{label}<span>{locale === 'en' ? 'Open contents' : locale === 'ja' ? '目次を開く' : '展开目录'}</span></summary><nav aria-label={label}>{items.map((item) => <a href={`#${item.id}`}>{item.text}</a>)}</nav></details>
</aside>
<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-mobile-toc]').forEach((toc) => {
    toc.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => link.addEventListener('click', () => {
      if (matchMedia('(min-width: 821px)').matches) return;
      toc.open = false;
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (target) { target.setAttribute('tabindex', '-1'); target.focus({ preventScroll: true }); }
    }));
  });
</script>
<style>
  .toc-mobile{display:none}.article-toc a:focus-visible,.toc-mobile summary:focus-visible{outline:2px solid var(--green);outline-offset:4px}@media(max-width:820px){.toc-desktop{display:none}.toc-mobile{display:block}.toc-mobile summary{cursor:pointer;font-size:13px;min-height:40px;align-content:center}.toc-mobile summary>span{float:right;font-size:11px;color:var(--muted);font-weight:400}.toc-mobile[open] summary>span{display:none}.article-toc .toc-mobile nav{display:grid;grid-template-columns:minmax(0,1fr);gap:0;margin-top:8px}.article-toc .toc-mobile a{padding:11px 4px;border-top:1px solid var(--line);font-size:12px}}
</style>
