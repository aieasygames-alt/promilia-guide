---
import { contentRoutes, topicLabels } from '../data/content-routes';
import { articlePath, type Guide, type ReferenceLocale as Locale } from '../lib/content';
interface Props { locale: Locale; entries: Guide[]; section?: 'guides' | 'systems' }
const { locale, entries, section } = Astro.props;
const groups = contentRoutes.filter(group => section === 'systems' ? group.id === 'play' : section === 'guides' ? group.id !== 'play' : true);
---
<nav class="content-routes" aria-label={locale === 'ja' ? '目的から探す' : '按当前任务找攻略'}>
  {groups.map((group, index) => <section class="route-group">
    <span class="route-number" aria-hidden="true">0{index + 1}</span><div><h2>{group.title[locale]}</h2><p>{group.note[locale]}</p>
    <ul>{group.topics.flatMap(id => { const entry = entries.find(entry => entry.data.contentId === id); return entry ? [<li><a href={articlePath(entry.data)}>{topicLabels[id][locale]}</a></li>] : []; })}</ul></div>
  </section>)}
</nav>
<style>
  .content-routes { display: grid; gap: 1rem; margin: 0 0 2.5rem; }
  .route-group { display: flex; gap: 1.25rem; padding: 1.4rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper, #fffdf8); }
  .route-number { color: var(--green); font: italic 1.8rem Georgia, serif; opacity: .6; }
  h2 { font-size: 1.1rem; margin: 0 0 .3rem; }
  p { color: var(--muted); font-size: .9rem; margin: 0 0 .9rem; }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem 1rem; padding: 0; margin: 0; }
  a { font-size: .9rem; color: var(--green); text-decoration: underline; text-underline-offset: .25em; }
  a:hover { color: var(--ink); }
  @media (max-width: 520px) { .route-group { padding: 1rem; gap: .8rem; } }
</style>
