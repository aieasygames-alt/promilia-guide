---
import type { Entity, EntityLocale } from '../data/entities';
import type { Source } from '../lib/facts';
import Icon from './Icon.astro';
import { entityCategory } from '../lib/entity-category.mjs';

interface Props {
  entity: Entity;
  locale: EntityLocale;
  source?: Source;
  index: number;
}

const { entity, locale, source, index } = Astro.props;
const ja = locale === 'ja';
const sourceLabel = ja ? '公式ページ' : '官方页面';
const imageSourceLabel = entity.imageSource === 'official' ? (ja ? '公式画像' : '官方图片') : (ja ? '第三者画像' : '第三方图片');
const classificationLabel = ja ? '分類' : '分类';
const originLabel = ja ? '所属・ゆかりの地' : '所属与相关地区';
const cvLabel = ja ? '声優（CV）' : '声优（CV）';
const featureLabel = ja ? '公開特徴・機能' : '公开特性与机能';

const category = entityCategory(entity);
---

<article class={`entity-card entity-card-${entity.kind}`} data-entity-id={entity.id} data-entity-kind={entity.kind} data-entity-category={category}>
  <figure class={`entity-media entity-media-${entity.kind}`} data-image-source={entity.imageSource}>
    <img
      class="entity-image"
      src={entity.image}
      alt={entity.imageAlt[locale]}
      width="1200"
      height="1200"
      loading={index === 0 ? 'eager' : 'lazy'}
      decoding="async"
    />
    <figcaption>{imageSourceLabel}</figcaption>
  </figure>
  <div class="entity-card-topline">
    <span class="entity-number">0{index + 1}</span>
    <span class="pill">{entity.catalogStatus === 'verified' ? (ja ? '公式発表' : '官方已公布') : (ja ? '確認中' : '待核验')}</span>
  </div>
  <header class="entity-card-heading">
    <div>
      <h2>{entity.names[locale]}</h2>
      <p class="entity-romanized">{entity.romanized}</p>
    </div>
    <span class="entity-mark" aria-hidden="true"><Icon name={entity.kind === 'character' ? 'person' : 'leaf'} size={24}/></span>
  </header>
  <p class="entity-aliases" data-pagefind-weight="0.4">{entity.aliases[locale]}</p>
  <p class="entity-summary">{entity.summary[locale]}</p>
  {entity.quote && <blockquote>{entity.quote[locale]}</blockquote>}
  {(entity.classification || entity.origin || entity.cv || entity.feature) && <dl class="entity-facts">
    {entity.cv && <div><dt>{cvLabel}</dt><dd><b>{entity.cv[locale]}</b></dd></div>}
    {entity.classification && <div><dt>{classificationLabel}</dt><dd>{entity.classification[locale]}</dd></div>}
    {entity.origin && <div><dt>{originLabel}</dt><dd>{entity.origin[locale]}</dd></div>}
    {entity.feature && <div><dt>{featureLabel}</dt><dd>{entity.feature[locale]}</dd></div>}
  </dl>}
  <div class="entity-card-action" style="padding: 0 0 1rem;">
    <a class="text-link" href={`/${locale}/${entity.kind === 'character' ? 'characters' : 'kibo'}/${entity.id}/`}>{ja ? '資料と確認状況' : '资料摘要与核验状态'}<Icon name="arrow" size={14}/></a>
  </div>
  <footer class="entity-card-footer">
    <span>{ja ? '資料確認日：' : '资料核对：'}{source?.checkedAt || (ja ? '確認中' : '待核验')}</span>
    {source?.url && <a href={source.url} target="_blank" rel="noopener noreferrer">{sourceLabel}<Icon name="arrow" size={14}/></a>}
  </footer>
</article>
