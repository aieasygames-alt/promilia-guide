---
import { claims, sources } from '../lib/facts';
import { isVerifiedClaim } from '../lib/editorial.mjs';
import type { ReferenceLocale as Locale } from '../lib/content';
interface Props { locale: Locale; refs: string[]; revisions: Record<string, number> }
const { locale, refs, revisions } = Astro.props;
const ja = locale === 'ja';
const items = refs.map((id) => claims.find((claim) => claim.id === id)!).filter(Boolean);
---
{items.length > 0 && <section class="claim-summary" aria-labelledby="claim-summary-title">
  <div class="claim-summary-heading"><h2 id="claim-summary-title">{ja ? '確認できたこと・確認中のこと' : '已确认与待确认'}</h2><span>{ja ? '共通の出典から整理' : '依据共享来源整理'}</span></div>
  <ul>{items.map((claim) => {
    const verified = isVerifiedClaim(claim, sources);
    const stale = revisions[claim.id] !== claim.revision;
    const text = claim.localized[locale];
    return <li data-claim-id={claim.id} data-claim-revision={claim.revision} data-claim-verified={String(verified)}>
      <div class="claim-summary-line"><span class={`pill ${verified ? '' : 'pending'}`}>{verified ? (ja ? '出典確認済み' : '来源已核验') : (ja ? '確認中' : '待核验')}</span><span class="claim-revision">r{claim.revision}</span></div>
      <p class="claim-text">{text.summary}</p>{text.detail && <p class="claim-detail">{text.detail}</p>}
      {verified && claim.value.url && <a class="text-link" href={claim.value.url} target="_blank" rel="noopener noreferrer">{ja ? '確認した公式ページを開く' : '打开已核验的官方页面'} ↗</a>}
      {stale && <p class="claim-stale">{ja ? '出典側の情報が更新されています。本文の再確認が必要です。' : '引用事实已有更新，正文需要重新核对。'}</p>}
      <div class="claim-citations">{claim.sourceRefs.map((id) => { const source = sources.find((source) => source.id === id); return source && <a href={`#source-${source.id}`}>{source.localized?.[locale]?.title || source.title}</a>; })}</div>
    </li>;
  })}</ul>
</section>}
<style>
  .claim-summary{margin:25px 0 32px;border:1px solid #cbd7c1;border-radius:5px;background:#f0f3e9;padding:23px 26px}.claim-summary-heading{display:flex;gap:15px;justify-content:space-between;align-items:center;border-bottom:1px solid #d5ddcb;padding-bottom:16px}.claim-summary h2{font:500 22px var(--serif)}.claim-summary-heading>span{font-size:10px;color:var(--muted)}.claim-summary ul{list-style:none;margin:0;padding:0}.claim-summary li{padding:20px 0;border-bottom:1px solid #d5ddcb}.claim-summary li:last-child{border:0;padding-bottom:0}.claim-summary-line{display:flex;gap:10px;align-items:center}.claim-revision{font-size:10px;color:var(--muted)}.claim-text{font-size:14px;line-height:1.9;margin:11px 0 5px}.claim-detail{font-size:12px;color:var(--muted);line-height:1.9}.claim-citations{display:flex;flex-wrap:wrap;gap:5px 12px;margin-top:12px}.claim-citations a{font-size:10px;text-decoration:underline;text-underline-offset:3px;color:#657c63}.claim-stale{background:#eee0c4;padding:10px;font-size:12px;margin-top:10px}.claim-summary .text-link{margin-top:9px;font-size:12px}@media(max-width:580px){.claim-summary{padding:20px}.claim-summary-heading{display:block}.claim-summary h2{font-size:20px}.claim-summary-heading>span{display:block;margin-top:7px}.claim-text{font-size:13px}}
</style>
