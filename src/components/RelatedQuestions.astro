---
import questions from '../data/faq.json';
import type { ReferenceLocale as Locale } from '../lib/content';
interface Props { locale: Locale; contentId: string }
const { locale, contentId } = Astro.props;
const related = questions.flatMap<(typeof questions)[number]['questions'][number]>(group => group.questions).filter(question => question.contentId === contentId);
---
{related.length > 0 && <section class="related-questions" data-pagefind-ignore><h2>{locale === 'ja' ? 'このテーマのよくある質問' : '这个主题的常见问题'}</h2><ul>{related.map(question => <li><a href={`/${locale}/faq/#q-${question.id}`}>{question.question[locale]} →</a></li>)}</ul></section>}
<style>
  .related-questions { margin: 2rem 0; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  h2 { font-size: 1.15rem; } ul { padding-left: 1.2rem; } li { margin: .65rem 0; line-height: 1.8; }
  a { color: var(--green); text-decoration: underline; text-underline-offset: .25em; }
</style>
