---
import Icon from './Icon.astro';

interface Props {
  locale: 'zh-hans' | 'ja';
}

const { locale } = Astro.props;
const ja = locale === 'ja';

const codes = [
  {
    code: 'AZURPROMILIA2026',
    reward: ja ? 'ユニ × 50,000、育成素材パック' : '尤尼 × 50,000、养成素材箱',
    scope: ja ? '全サーバー共通 · 正式配信記念' : '全服通用 · 公测开服纪念',
    status: ja ? '配信時有効' : '公测生效',
    isNew: true,
  },
  {
    code: 'STARAY1126',
    reward: ja ? '純粋な追憶 × 1、メテオールの特製料理' : '纯粹忆痕 × 1、星鳐特色料理',
    scope: ja ? '配信日決定記念コード' : '定档纪念通用礼包',
    status: ja ? '有効' : '有效',
    isNew: true,
  },
  {
    code: 'WELCOMESTAR',
    reward: ja ? '純粋な星脈結晶 × 5、初級経験素材' : '纯澈的星脉结晶 × 5、初级经验素材',
    scope: ja ? '新規プレイヤー歓迎特典' : '新人星使启程礼包',
    status: ja ? '恒常' : '长期有效',
    isNew: false,
  },
];

const copyLabel = ja ? 'コピー' : '一键复制';
const copiedLabel = ja ? 'コピー完了！' : '已复制！';
---

<div class="redeem-box" data-redeem-container>
  <div class="redeem-box-header">
    <div>
      <span class="pill">{ja ? 'ワンタップコピー' : '便捷交互'}</span>
      <h3>{ja ? '公開中シリアルコード一覧' : '当前可用兑换码速取'}</h3>
    </div>
    <small class="text-muted">{ja ? 'タップしてクリップボードにコピー' : '点击按钮直接复制到剪贴板'}</small>
  </div>

  <div class="redeem-card-grid">
    {codes.map((item) => (
      <div class="redeem-item-card">
        <div class="redeem-item-main">
          <div class="redeem-code-line">
            <code class="redeem-code-text">{item.code}</code>
            {item.isNew && <span class="pill draft">{ja ? 'NEW' : '最新'}</span>}
            <span class="pill">{item.status}</span>
          </div>
          <p class="redeem-item-reward">{item.reward}</p>
          <small class="redeem-item-scope">{item.scope}</small>
        </div>
        <button
          type="button"
          class="redeem-copy-btn"
          data-copy-target={item.code}
          data-label-default={copyLabel}
          data-label-copied={copiedLabel}
          aria-label={`${copyLabel} ${item.code}`}
        >
          <Icon name="arrow" size={14} />
          <span>{copyLabel}</span>
        </button>
      </div>
    ))}
  </div>
</div>

<style>
  .redeem-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin: 1.5rem 0 2rem;
  }
  .redeem-box-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .redeem-box-header h3 {
    margin: 0.25rem 0 0;
    font-size: 1.1rem;
  }
  .redeem-card-grid {
    display: grid;
    gap: 0.85rem;
  }
  .redeem-item-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.85rem 1.1rem;
    gap: 1rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .redeem-item-card:hover {
    border-color: var(--primary, #589b88);
    background: rgba(255, 255, 255, 0.05);
  }
  .redeem-item-main {
    flex: 1;
    min-width: 0;
  }
  .redeem-code-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }
  .redeem-code-text {
    font-family: var(--mono, monospace);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--gold, #deb887);
    background: rgba(0, 0, 0, 0.25);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    user-select: all;
  }
  .redeem-item-reward {
    margin: 0.15rem 0;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .redeem-item-scope {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .redeem-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text, #f0f0f0);
    background: var(--primary, #2d5a52);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .redeem-copy-btn:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
  }
  .redeem-copy-btn.copied {
    background: #2e694d;
    color: #bbf7d0;
    border-color: #86efac;
  }
  @media (max-width: 640px) {
    .redeem-item-card {
      flex-direction: column;
      align-items: stretch;
    }
    .redeem-copy-btn {
      justify-content: center;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-redeem-container]').forEach((container) => {
    container.querySelectorAll<HTMLButtonElement>('button[data-copy-target]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copyTarget;
        if (!text) return;
        const defaultLabel = btn.dataset.labelDefault || '复制';
        const copiedLabel = btn.dataset.labelCopied || '已复制！';
        const labelSpan = btn.querySelector('span');

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
          } else {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
          }
          btn.classList.add('copied');
          if (labelSpan) labelSpan.textContent = copiedLabel;
          setTimeout(() => {
            btn.classList.remove('copied');
            if (labelSpan) labelSpan.textContent = defaultLabel;
          }, 2000);
        } catch {
          // Fallback: 如果被拦截则提醒
          prompt('请手动复制兑换码：', text);
        }
      });
    });
  });
</script>
