---
import { redeemCodes } from '../lib/redeem-data';
import { sources as defaultSources } from '../lib/facts';
import { redeemCodeRows, announcedCodeRows } from '../lib/redeem-codes.mjs';
interface Props { locale: 'zh-hans' | 'ja'; codeData?: typeof redeemCodes; sourceData?: typeof defaultSources }
const { locale, codeData = redeemCodes, sourceData: sources = defaultSources } = Astro.props;
const ja = locale === 'ja';
const codes = redeemCodeRows({ codes: codeData, sources });
const hasAnnouncements = announcedCodeRows({ codes: codeData, sources }).length > 0;
---
{(codes.length > 0 || !hasAnnouncements) && <section class="redeem-box" data-redeem-container aria-labelledby="redeem-title">
  <h2 id="redeem-title">{ja ? '有効期間を自動判定できるコード' : '可自动核对有效期的代码'}</h2>
  <p class="search-help">{ja ? '対象地域と有効期間を確認してください。コピーは受取成功を意味しません。' : '请逐条核对地区与有效期。复制不代表兑换成功。'}</p>
  {codes.length ? <div class="redeem-card-grid">{codes.map(item => <article class="redeem-item-card" data-code-region={item.region} data-code-start={item.availableAt} data-code-expiry={item.expiresAt}>
    <header><code>{item.code}</code><span class="pill">{item.region === 'cn' ? (ja ? '中国本土' : '中国大陆') : (ja ? '日本' : '日本地区')}</span></header>
    <p>{item.reward![locale]}</p>
    <p>{item.redemptionMethod![locale]}</p>
    <p class="code-validity"><time datetime={item.availableAt!}>{item.availableAt!.replace('T',' ')}</time> → <time datetime={item.expiresAt!}>{item.expiresAt!.replace('T',' ')}</time> ({item.timeZone})</p>
    <p data-code-status data-ja={String(ja)}>{item.status === 'expired' ? (ja ? '期限切れ' : '已到期') : item.status === 'scheduled' ? (ja ? '受付開始前' : '尚未开始') : (ja ? '有効期間は上記日時を確認' : '有效期请核对上方日期')}</p>
    <button type="button" class="button redeem-copy-btn" data-copy-target={item.code} data-label-copied={ja ? 'コピー完了' : '已复制'} data-label-failed={ja ? 'コピーできませんでした。上の文字列を選択してコピーしてください。' : '复制失败，请选中上方代码手动复制。'} disabled>{ja ? 'コピー' : '复制代码'}</button>
    <small>{item.sourceRefs.map(id => <a href={sources.find(source=>source.id===id)!.url!} target="_blank" rel="noopener noreferrer">{ja ? '公式原文' : '官方原文'} ↗ </a>)}</small>
  </article>)}</div> : <p class="notice" data-code-empty>{ja ? '報酬・開始時刻・期限・タイムゾーンがすべて揃った自動判定用の記録は現在ありません。公式発表済みのコードは上の案内を確認してください。' : '当前没有奖励、起止时刻和时区全部齐备的自动判定记录。官方已公布的代码请看上方说明。'}</p>}
  <p data-copy-feedback role="status" aria-live="polite"></p>
</section>}
<script>
  document.querySelectorAll<HTMLElement>('[data-redeem-container]').forEach(container => {
    const feedback = container.querySelector<HTMLElement>('[data-copy-feedback]')!;
    container.querySelectorAll<HTMLElement>('[data-code-expiry]').forEach(card => {
      const button = card.querySelector<HTMLButtonElement>('button')!;
      const status = card.querySelector<HTMLElement>('[data-code-status]')!;
      const active = () => Date.now() >= Date.parse(card.dataset.codeStart!) && Date.now() < Date.parse(card.dataset.codeExpiry!);
      const update = () => {
        button.disabled = !active();
        status.textContent = Date.now() >= Date.parse(card.dataset.codeExpiry!) ? (status.dataset.ja === 'true' ? '期限切れ' : '已到期') : active() ? (status.dataset.ja === 'true' ? '有効期間内・利用条件を確認' : '有效期内，请核对领取条件') : (status.dataset.ja === 'true' ? '受付開始前' : '尚未开始');
      };
      update(); window.setInterval(update, 1000);
      button.addEventListener('click', async () => {
        update(); if (button.disabled) return;
        try {
          if (!navigator.clipboard || !window.isSecureContext) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(button.dataset.copyTarget!);
          feedback.textContent = button.dataset.labelCopied!;
        } catch { feedback.textContent = button.dataset.labelFailed!; }
      });
    });
  });
</script>
<style>
  .redeem-box { margin: 1.5rem 0 2rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); }
  .redeem-box h2 { margin: 0; font-size: 1.2rem; }
  .redeem-card-grid { display: grid; gap: .9rem; }
  .redeem-item-card { border: 1px solid var(--line); border-radius: .5rem; padding: 1rem; }
  .redeem-item-card header { display: flex; flex-wrap: wrap; gap: .7rem; align-items: center; }
  .redeem-item-card code { overflow-wrap: anywhere; font-weight: 700; }
  .redeem-item-card small { display: block; margin-top: .6rem; }
  .code-validity { font-size: .8rem; color: var(--muted); overflow-wrap: anywhere; }
  button:disabled { opacity: .55; cursor: default; }
</style>
